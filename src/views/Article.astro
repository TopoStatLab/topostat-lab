---
import Base from '../layouts/Base.astro'
import PageHeading from '../components/PageHeading.astro'
import Picture from '../components/Picture.astro'
import { articles, articleHref, type Article } from '../data/articles'
import { formatDate } from '../data/news'
import { ui, t, localizedPath, type Lang } from '../i18n'

interface Props {
  lang: Lang
  article: Article
}
const { lang, article } = Astro.props
const zh = lang === 'zh'
const others = articles.filter((a) => a.slug !== article.slug)
const ld = {
  '@context': 'https://schema.org',
  '@type': 'NewsArticle',
  headline: t(article.title, lang),
  datePublished: article.date,
  image: [new URL(article.cover.src, 'https://topostat.cn').href],
  publisher: { '@type': 'Organization', name: zh ? '复杂系统拓扑统计理论及应用北京市重点实验室' : ui.siteName.en },
}
---

<Base lang={lang} path={articleHref(article.slug)} title={t(article.title, lang)} description={t(article.summary, lang)} jsonLd={[ld]}>
  <PageHeading lang={lang} title={zh ? '新闻' : 'News'} />
  <section class="wrap vsec" style="padding-top:clamp(48px,6vw,72px)">
    <p class="vlabel" aria-hidden="true">{zh ? '实验室新闻' : 'Lab news'}</p>
    <article class="article">
      <h1 class="section-title" style="margin-bottom:16px">{t(article.title, lang)}</h1>
      <p class="article-meta"><time datetime={article.date}>{formatDate(article.date, lang)}</time><span>{t(article.place, lang)}</span></p>
      {article.blocks.map((b) =>
        'p' in b ? (
          <p>{t(b.p, lang)}</p>
        ) : (
          <figure>
            <Picture image={b.img} alt={b.img.alt[lang]} sizes="(max-width: 760px) 100vw, 704px" />
            <figcaption>{t(b.caption, lang)}</figcaption>
          </figure>
        ),
      )}
      {!zh && <p style="font-size:var(--t-xs);color:var(--ink-3)">Translated from the laboratory’s Chinese news release.</p>}
      <div class="article-foot">
        <a href={localizedPath('/news/', lang)}>{zh ? '返回新闻' : 'All news'}</a>
      </div>
      {others.length > 0 && (
        <div style="margin-top:40px">
          <p class="e-date" style="margin-bottom:6px">{zh ? '其他新闻' : 'More news'}</p>
          <ul class="article-related">
            {others.map((a) => <li><a href={localizedPath(articleHref(a.slug), lang)}>{t(a.title, lang)}</a></li>)}
          </ul>
        </div>
      )}
    </article>
  </section>
</Base>
