---
import Base from '../layouts/Base.astro'
import PageHeading from '../components/PageHeading.astro'
import PersonCard from '../components/PersonCard.astro'
import { director, deputies, assistants, committeeChair, committeeMembers, members, tiers, type Person } from '../data/people'
import { site } from '../data/site'
import { ui, t, localizedPath, type Lang } from '../i18n'

interface Props {
  lang: Lang
}
const { lang } = Astro.props
const zh = lang === 'zh'

const everyone: Person[] = [director, ...deputies, ...assistants, committeeChair, ...committeeMembers, ...members].filter(
  (p, i, all) => all.findIndex((q) => q.id === p.id) === i,
)
const jsonLd = [
  {
    '@context': 'https://schema.org',
    '@graph': everyone.map((p) => ({
      '@type': 'Person',
      name: p.name.zh,
      alternateName: p.name.en,
      ...(p.role ? { jobTitle: p.role.en } : {}),
      ...(p.homepage ? { url: p.homepage } : {}),
      affiliation: { '@type': 'ResearchOrganization', name: ui.siteName.zh },
    })),
  },
]
const memberCount = members.length
const elsewhere = new Set([director, ...deputies, ...assistants, committeeChair, ...committeeMembers].map((p) => p.id))
---

<Base
  lang={lang}
  path="/about/"
  title={t(ui.overview, lang)}
  description={zh ? '复杂系统拓扑统计理论及应用北京市重点实验室：实验室介绍、组织架构与学术委员会。' : 'Introduction, organization and academic committee of the Beijing Key Laboratory of Topological Statistics and Applications for Complex Systems.'}
  jsonLd={jsonLd}
>
  <PageHeading lang={lang} title={t(ui.overview, lang)} />

  <section class="section" id="intro" aria-labelledby="h-intro" style="padding-top:clamp(32px,5vw,56px)">
    <div class="wrap row">
      <div class="main about">
        <h2 class="section-title" id="h-intro">{t(ui.intro, lang)}</h2>
        {zh ? (
          <>
            <p>复杂系统拓扑统计理论及应用北京市重点实验室依托北京雁栖湖应用数学研究院（BIMSA）建设，与中国人民大学数学学院联合共建，于 2025 年 2 月正式挂牌成立。丘成桐先生任学术委员会主任，邬荣领教授任实验室主任。</p>
            <p>实验室把拓扑学引入统计科学，致力于建立源自中国的统计拓扑理论框架，重点发展从复杂、大规模数据中发现基本规律的统计模型与算法。三大研究方向是：广义统计物理学、拓扑统计学新理论，以及面向高阶互作复杂网络的统计拓扑学。</p>
            <p>依托丘成桐先生提出的 GLMY 拓扑理论和邬荣领教授团队发展的 idopNetwork 统计模型，实验室已将复杂网络的拓扑特性用于研究生物系统中的信息传递与功能调控，例如炎性肠病相关的代谢网络。目前实验室有 54 名固定研究人员，其中 22 人拥有海外博士学位，覆盖统计学、概率论与数据科学、代数拓扑及其应用、人工智能与机器学习等方向。</p>
          </>
        ) : (
          <>
            <p>The Beijing Key Laboratory of Topological Statistics and Applications for Complex Systems is hosted by the Beijing Institute of Mathematical Sciences and Applications (BIMSA) and co-built with the School of Mathematics at Renmin University of China. It was officially established in February 2025. Prof. Shing-Tung Yau chairs the Academic Committee and Prof. Rongling Wu is Director.</p>
            <p>By bringing topology into statistical science, the laboratory aims to build a China-originated framework of statistical topology, with a focus on statistical models and algorithms that uncover fundamental patterns in complex, large-scale data. Its three directions are generalized statistical physics, a new theory of topological statistics, and statistical topology for complex networks with higher-order interactions.</p>
            <p>Building on Prof. Yau’s GLMY theory and the idopNetwork models developed by Prof. Wu’s team, the laboratory uses the topology of complex networks to study information flow and functional regulation in biological systems, such as metabolic networks in inflammatory bowel disease. It has 54 permanent researchers, 22 with overseas PhDs, across statistics, probability and data science, algebraic topology, and artificial intelligence.</p>
          </>
        )}
      </div>
      <aside class="note">
        <h3>{zh ? '依托与共建' : 'Host and partner'}</h3>
        <p><a href={site.hostInstitution.url} target="_blank" rel="noopener">{site.hostInstitution[lang]}</a></p>
        <p>{site.partnerInstitution[lang]}</p>
        <p style="margin-top:12px"><a href="https://kw.beijing.gov.cn/xwdt/kcyx/xwdtscyqld/202502/t20250214_4010193.html" target="_blank" rel="noopener">{zh ? '北京市科委成立公告' : 'Establishment announcement (in Chinese)'}</a></p>
      </aside>
    </div>
  </section>

  <section class="section" id="organization" aria-labelledby="h-org">
    <div class="wrap">
      <h2 class="section-title" id="h-org">{t(ui.organization, lang)}</h2>

      <div class="lead-grid">
        <div>
          <h3 class="tier-label">{zh ? '主任' : 'Director'}</h3>
          <ul class="people"><PersonCard person={director} lang={lang} showRole={false} eager /></ul>
        </div>
        <div>
          <h3 class="tier-label">{zh ? '副主任' : 'Deputy director'}</h3>
          <ul class="people">{deputies.map((p) => <PersonCard person={p} lang={lang} showRole={false} />)}</ul>
        </div>
        <div>
          <h3 class="tier-label">{zh ? '助理' : 'Assistants'}</h3>
          <ul class="people">{assistants.map((p) => <PersonCard person={p} lang={lang} />)}</ul>
        </div>
      </div>
      <div class="tier">
        <h3 class="tier-label">{zh ? '成员' : 'Members'}<small>{zh ? `${memberCount} 人` : `${memberCount} people`}</small></h3>
        <div>
          {tiers.map((tier) => {
            const list = members.filter((m) => m.tier === tier.id)
            return list.length > 0 && (
              <div class="team-block" id={`tier-${tier.id}`}>
                <h4 class="team-name">{t(tier.label, lang)}<span>{zh ? `${list.length} 人` : list.length}</span></h4>
                <ul class="people">{list.map((p) => <PersonCard person={p} lang={lang} showRole={false} anchor={!elsewhere.has(p.id)} />)}</ul>
              </div>
            )
          })}
        </div>
      </div>
    </div>
  </section>

  <section class="section" id="committee" aria-labelledby="h-committee">
    <div class="wrap">
      <h2 class="section-title" id="h-committee">{t(ui.committee, lang)}</h2>
      <div class="tier">
        <h3 class="tier-label">{zh ? '主任' : 'Chair'}</h3>
        <ul class="people lead"><PersonCard person={committeeChair} lang={lang} showRole={false} /></ul>
      </div>
      <div class="tier">
        <h3 class="tier-label">{zh ? '委员' : 'Members'}</h3>
        <ul class="people">{committeeMembers.map((p) => <PersonCard person={p} lang={lang} showRole={false} />)}</ul>
      </div>
    </div>
  </section>
</Base>
