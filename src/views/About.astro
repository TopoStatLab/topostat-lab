---
import Base from '../layouts/Base.astro'
import PageHeading from '../components/PageHeading.astro'
import PersonCard from '../components/PersonCard.astro'
import { director, deputies, committeeChair, committeeMembers, members, type Person, linkNames } from '../data/people'
import { site } from '../data/site'
import { ui, t, localizedPath, type Lang } from '../i18n'

interface Props {
  lang: Lang
}
const { lang } = Astro.props
const zh = lang === 'zh'

const everyone: Person[] = [director, ...deputies, committeeChair, ...committeeMembers, ...members].filter(
  (p, i, all) => all.findIndex((q) => q.id === p.id) === i,
)
const jsonLd = [
  {
    '@context': 'https://schema.org',
    '@graph': everyone.map((p) => ({
      '@type': 'Person',
      name: p.name.zh,
      alternateName: p.name.en,
      ...(p.role ? { jobTitle: p.role.en } : {}),
      ...(p.homepage ? { url: p.homepage } : {}),
      affiliation: { '@type': 'ResearchOrganization', name: ui.siteName.zh },
    })),
  },
]
const memberCount = members.length
// Academic secretary, with the photo and homepage from the member list.
const secretary = members.find((m) => m.id === 'dong-ang')
// Organization chart: photo and name on the left, every title on its own line to the right.
const lines = (p: Person) => (p.honors?.length ? p.honors.map((h) => t(h, lang)) : p.title ? t(p.title, lang).split(zh ? '、' : '; ') : [])
const org = [
  { label: zh ? '主任' : 'Director', person: director, anchor: true },
  ...deputies.map((p) => ({ label: zh ? '副主任' : 'Deputy director', person: p, anchor: true })),
  ...(secretary ? [{ label: zh ? '学术秘书' : 'Academic secretary', person: { ...secretary, title: { zh: '北京雁栖湖应用数学研究院助理研究员', en: 'Assistant Professor, BIMSA' } }, anchor: false }] : []),
]
const leaders = new Set([director, ...deputies].map((p) => p.id))
---

<Base
  lang={lang}
  path="/about/"
  title={t(ui.overview, lang)}
  description={zh ? '复杂系统拓扑统计理论及应用北京市重点实验室：实验室介绍、组织架构与学术委员会。' : 'Introduction, organization and academic committee of the Beijing Key Laboratory of Topological Statistics and Applications for Complex Systems.'}
  jsonLd={jsonLd}
>
  <PageHeading lang={lang} title={t(ui.overview, lang)} lead={zh ? '依托北京雁栖湖应用数学研究院（BIMSA）建设的北京市重点实验室。' : 'A Beijing Key Laboratory hosted by the Beijing Institute of Mathematical Sciences and Applications (BIMSA).'} />

  <section class="section" id="intro" aria-labelledby="h-intro" style="padding-top:clamp(32px,5vw,56px)">
    <div class="wrap row">
      <div class="main about">
        <h2 class="section-title" id="h-intro">{t(ui.intro, lang)}</h2>
        {zh ? (
          <>
            <p set:html={linkNames('复杂系统拓扑统计理论及应用北京市重点实验室由北京雁栖湖应用数学研究院（BIMSA）依托建设、中国人民大学数学学院联合共建，于 2025 年 2 月正式挂牌成立。实验室由丘成桐先生担任学术委员会主席，邬荣领教授担任实验室主任。')} />
            <p set:html={linkNames('实验室立足拓扑学与统计科学的深度交叉，致力于构建具有自主原创性的图统计学理论框架，重点突破面向复杂大规模非欧几里得数据的统计模型与核心算法。其三大核心研究方向涵盖：广义统计物理学、图统计学新理论，以及面向高阶互作复杂网络的统计拓扑学。')} />
            <p set:html={linkNames('在理论创新与实践应用方面，实验室融合丘成桐先生提出的 GLMY 拓扑理论与邬荣领教授团队开发的 idopNetwork 统计模型，开创了图统计学新理论。依托该理论提取的网络拓扑特性，实验室深入解析复杂系统中的信息传递与功能调控机制，并在阐明人类复杂疾病形成机理方面取得重要突破；例如，通过对炎性肠病相关代谢网络的深度解析，成功揭示了炎症形成的关键代谢通路，为新型靶向干预药物的研发提供了重要理论指导。')} />
            <p set:html={linkNames('目前，实验室已汇聚 54 名固定研究人员（其中 22 人拥有海外博士学位），研究布局全面覆盖统计学、概率论与数据科学、代数拓扑及其应用、人工智能与机器学习等前沿领域。')} />
          </>
        ) : (
          <>
            <p set:html={linkNames('The Beijing Key Laboratory of Topological Statistics and Applications for Complex Systems is hosted by the Beijing Institute of Mathematical Sciences and Applications (BIMSA) and co-built with the School of Mathematics at Renmin University of China. It was officially established in February 2025. Prof. Shing-Tung Yau chairs the Academic Committee and Prof. Rongling Wu is Director.')} />
            <p set:html={linkNames('Working at the deep intersection of topology and statistical science, the laboratory aims to build an original theoretical framework of graph statistics, with a focus on statistical models and core algorithms for complex, large-scale non-Euclidean data. Its three core directions are generalized statistical physics, a new theory of graph statistics, and statistical topology for complex networks with higher-order interactions.')} />
            <p set:html={linkNames('Combining the GLMY topology proposed by Prof. Shing-Tung Yau with the idopNetwork statistical models developed by Prof. Rongling Wu’s team, the laboratory has founded a new theory of graph statistics. Using the network topology this theory extracts, it studies information flow and functional regulation in complex systems and has made major advances in explaining how complex human diseases form. For example, an in-depth analysis of metabolic networks in inflammatory bowel disease revealed the key metabolic pathways behind inflammation, offering theoretical guidance for developing new targeted therapies.')} />
            <p set:html={linkNames('The laboratory now has 54 permanent researchers, 22 of them with overseas PhDs, covering statistics, probability and data science, algebraic topology and its applications, and artificial intelligence and machine learning.')} />
          </>
        )}
      </div>
      <aside class="note">
        <h3>{zh ? '依托单位' : 'Host institution'}</h3>
        <p><a href={site.hostInstitution.url} target="_blank" rel="noopener">{site.hostInstitution[lang]}</a></p>
        <h3 style="margin-top:12px">{zh ? '共建单位' : 'Co-building partner'}</h3>
        <p>{site.partnerInstitution[lang]}</p>
        <p style="margin-top:12px"><a href="https://kw.beijing.gov.cn/xwdt/kcyx/xwdtscyqld/202502/t20250214_4010193.html" target="_blank" rel="noopener">{zh ? '北京市科委成立公告' : 'Establishment announcement (in Chinese)'}</a></p>
      </aside>
    </div>
  </section>

  <section class="section" id="organization" aria-labelledby="h-org">
    <div class="wrap">
      <h2 class="section-title" id="h-org">{t(ui.organization, lang)}</h2>

      {org.map(({ label, person, anchor }, i) => (
        <div class="tier">
          <h3 class="tier-label">{label}</h3>
          <div class="org-row">
            <ul class="people lead"><PersonCard person={{ ...person, title: undefined }} lang={lang} showRole={false} eager={i === 0} anchor={anchor} /></ul>
            <ul class="org-titles">{lines(person).map((l) => <li>{l}</li>)}</ul>
          </div>
        </div>
      ))}
      <p class="org-more">
        {zh ? `实验室现有研究人员 ${memberCount} 人，按研究员、副研究员、助理研究员、博士后与学生分列，见` : `The laboratory has ${memberCount} researchers and students, listed by rank on the `}
        <a href={localizedPath('/people/', lang)}>{t(ui.people, lang)}</a>{zh ? '栏目。' : ' page.'}
      </p>
    </div>
  </section>

  <section class="section" id="committee" aria-labelledby="h-committee">
    <div class="wrap">
      <h2 class="section-title" id="h-committee">{t(ui.committee, lang)}</h2>
      <div class="tier">
        <h3 class="tier-label">{zh ? '主席' : 'Chair'}</h3>
        <div class="org-row">
          <ul class="people lead"><PersonCard person={{ ...committeeChair, title: undefined }} lang={lang} showRole={false} /></ul>
          <ul class="org-titles">{lines(committeeChair).map((l) => <li>{l}</li>)}</ul>
        </div>
      </div>
      <div class="tier">
        <h3 class="tier-label">{zh ? '委员' : 'Members'}</h3>
        <ul class="people">{committeeMembers.map((p) => <PersonCard person={p} lang={lang} showRole={false} anchor={!leaders.has(p.id)} />)}</ul>
      </div>
    </div>
  </section>
</Base>
