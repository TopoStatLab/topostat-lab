---
import Base from '../layouts/Base.astro'
import PageHeading from '../components/PageHeading.astro'
import SectionHeading from '../components/SectionHeading.astro'
import PersistenceDemo from '../components/PersistenceDemo.astro'
import { researchDirections, applications } from '../data/research'
import { publications, doiUrl } from '../data/publications'
import { ui, t, localizedPath, type Lang } from '../i18n'

interface Props {
  lang: Lang
}
const { lang } = Astro.props
const zh = lang === 'zh'
---

<Base
  lang={lang}
  path="/research/"
  title={t(ui.research, lang)}
  description={zh ? '实验室三大研究方向：广义统计物理与复杂网络、拓扑统计学、统计拓扑与高阶互作，以及持续同调交互演示。' : 'Our three research directions — generalized statistical physics and complex networks, topological statistics, statistical topology and higher-order interactions — plus an interactive persistent homology demo.'}
>
  <PageHeading
    eyebrow="SCIENTIFIC RESEARCH"
    title={t(ui.research, lang)}
    kicker="THEORY × DATA × INTELLIGENCE"
    desc={zh ? '围绕复杂系统的结构、动力学与高阶互作，形成从理论创新到计算方法再到真实应用的研究链条。' : 'From theory to computation to real-world application — studying the structure, dynamics and higher-order interactions of complex systems.'}
  />

  <section class="section direction-section">
    <div class="page-shell">
      {researchDirections.map((d, i) => {
        const papers = publications.filter((p) => p.directions.includes(d.id))
        return (
          <article class="direction-block anchor-target" id={d.id}>
            <div class="direction-index">{String(i + 1).padStart(2, '0')}</div>
            <div class="direction-main">
              <p class="research-en">{d.en}</p>
              <h2>{t(d.title, lang)}</h2>
              <p class="direction-body">{t(d.body, lang)}</p>
              <div class="tag-row">{d.tags.map((tag) => <span>{tag}</span>)}</div>
            </div>
            <div class="direction-papers">
              <h3>{zh ? '代表性成果' : 'Selected papers'}</h3>
              {papers.length ? (
                <ul>
                  {papers.map((p) => (
                    <li>
                      <a href={doiUrl(p.doi)} target="_blank" rel="noopener">
                        <span>{p.year} · {p.journal}</span>
                        {p.title}
                      </a>
                    </li>
                  ))}
                </ul>
              ) : (
                <p class="muted">{zh ? '即将更新' : 'Coming soon'}</p>
              )}
              <a class="text-link" href={localizedPath('/publications/', lang) + `?direction=${d.id}`}>{t(ui.viewAll, lang)} →</a>
            </div>
          </article>
        )
      })}
    </div>
  </section>

  <section class="section demo-section anchor-target" id="demo">
    <div class="page-shell">
      <div class="split-heading">
        <SectionHeading
          eyebrow="INTERACTIVE · PERSISTENT HOMOLOGY"
          title={zh ? '动手看见数据的形状' : 'See the shape of data'}
          desc={zh
            ? '持续同调是拓扑数据分析的核心工具。以每个点为圆心画半径 ε/2 的圆，相交即连边、三边两两相连即填成三角形（Vietoris–Rips 复形）。拖动 ε，观察连通分支（β₀）如何合并、环（β₁）如何出现又被填满。'
            : 'Persistent homology is the core tool of topological data analysis. Grow a ball of radius ε/2 around every point; connect points whose balls meet and fill in triangles (the Vietoris–Rips complex). Drag ε to watch components (β₀) merge and loops (β₁) appear and fill in.'}
        />
        <p class="demo-aside">
          {zh
            ? '噪声只会产生短暂的特征，而真实结构会在很宽的尺度范围内持续存在——这正是“拓扑统计”要做的：把“形状”变成可以检验、可以推断的统计量。'
            : 'Noise produces only short-lived features, while real structure persists across a wide range of scales — topological statistics turns that "shape" into quantities we can test and infer.'}
        </p>
      </div>
      <PersistenceDemo lang={lang} />
    </div>
  </section>

  <section class="applications-section">
    <div class="page-shell">
      <SectionHeading eyebrow="APPLICATIONS" title={zh ? '应用领域' : 'Application areas'} />
      <div class="application-grid">
        {applications.map((app, i) => (
          <article class="application-card">
            <span>{String(i + 1).padStart(2, '0')}</span>
            <p>{app.en}</p>
            <h3>{t(app.title, lang)}</h3>
            <div class="application-line"></div>
            <small>{t(app.body, lang)}</small>
          </article>
        ))}
      </div>
    </div>
  </section>
</Base>
