---
import Base from '../layouts/Base.astro'
import PageHeading from '../components/PageHeading.astro'
import { researchDirections, applications } from '../data/research'
import { sortedPublications, paperUrl } from '../data/publications'
import { ui, t, localizedPath, type Lang } from '../i18n'

interface Props {
  lang: Lang
}
const { lang } = Astro.props
const zh = lang === 'zh'
---

<Base
  lang={lang}
  path="/research/"
  title={t(ui.research, lang)}
  description={zh ? '实验室三大研究方向：广义统计物理与复杂网络、拓扑统计学、统计拓扑与高阶互作，以及持续同调交互演示。' : 'Our three research directions — generalized statistical physics and complex networks, topological statistics, statistical topology and higher-order interactions — plus an interactive persistent homology demo.'}
>
  <PageHeading
    lang={lang}
    title={t(ui.research, lang)}
    lead={zh ? '围绕复杂系统的结构、动力学与高阶互作，从理论创新到计算方法，再到真实应用。' : 'The structure, dynamics and higher-order interactions of complex systems — from theory to computation to real applications.'}
  />

  <section class="section" aria-label={t(ui.directions, lang)} style="padding-top:0;border-top:0">
    {researchDirections.map((d) => {
      const papers = sortedPublications.filter((p) => p.directions.includes(d.id)).slice(0, 4)
      return (
        <div class="wrap row">
          <article class="main direction" id={d.id}>
            <h2 class="section-title" style="margin-bottom:0">{t(d.title, lang)}</h2>
            <p>{t(d.body, lang)}</p>
            <p class="keywords">{d.tags.join(zh ? '，' : ', ')}</p>
          </article>
          <aside class="note direction-note">
            <h3>{zh ? '代表性成果' : 'Selected papers'}</h3>
            {papers.length ? (
              <ul>
                {papers.map((p) => (
                  <li><a href={paperUrl(p)} target="_blank" rel="noopener">{p.title}</a><br /><i>{p.journal}</i>, {p.year}</li>
                ))}
              </ul>
            ) : (
              <p>{zh ? '即将更新。' : 'Coming soon.'}</p>
            )}
            <p style="margin-top:10px"><a href={localizedPath('/publications/', lang) + `?direction=${d.id}`}>{zh ? '该方向的全部论文' : 'All papers in this direction'}</a></p>
          </aside>
        </div>
      )
    })}
  </section>

  <section class="section" aria-labelledby="h-apps">
    <div class="wrap row">
      <div class="main">
        <h2 class="section-title" id="h-apps">{zh ? '应用领域' : 'Where it applies'}</h2>
        <dl class="apps">
          {applications.map((app) => (
            <div>
              <dt>{t(app.title, lang)}</dt>
              <dd>{t(app.body, lang)}</dd>
            </div>
          ))}
        </dl>
      </div>
    </div>
  </section>
</Base>
