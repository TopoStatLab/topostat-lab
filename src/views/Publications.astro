---
import Base from '../layouts/Base.astro'
import PageHeading from '../components/PageHeading.astro'
import BibItem from '../components/BibItem.astro'
import { sortedPublications as pubs, paperUrl } from '../data/publications'
import { sortedPatents as patents } from '../data/patents'
import { researchDirections } from '../data/research'
import { ui, t, type Lang } from '../i18n'

interface Props {
  lang: Lang
}
const { lang } = Astro.props
const zh = lang === 'zh'
const years = [...new Set(pubs.map((p) => p.year))].sort((a, b) => b - a)
const jsonLd = [
  {
    '@context': 'https://schema.org',
    '@graph': pubs.map((p) => ({
      '@type': 'ScholarlyArticle',
      headline: p.title,
      datePublished: String(p.year),
      isPartOf: { '@type': 'Periodical', name: p.journal },
      ...(paperUrl(p) ? { sameAs: paperUrl(p) } : {}),
    })),
  },
]
---

<Base
  lang={lang}
  path="/publications/"
  title={t(ui.publications, lang)}
  description={zh ? '实验室成员近两年发表的论文与专利，覆盖拓扑统计、复杂网络、统计遗传与代数拓扑。' : 'Recent papers and patents by laboratory members in topological statistics, complex networks, statistical genetics and algebraic topology.'}
  jsonLd={jsonLd}
>
  <PageHeading
    lang={lang}
    title={t(ui.publications, lang)}
    lead={zh ? '实验室全体成员（含曾在实验室工作和学习的成员）的论文与专利，近两年优先，每年内实验室核心成员的成果排在前面。' : 'Papers and patents by all laboratory members, past and present. Recent years first; within each year, work by core members comes first.'}
  />

  <section class="section" id="papers" aria-labelledby="h-papers" style="padding-top:clamp(32px,5vw,56px)">
    <div class="wrap row">
      <div class="main">
        <h2 class="section-title" id="h-papers">{t(ui.papers, lang)}</h2>
        <div class="chips pub-filter" role="group" aria-label={zh ? '按研究方向筛选' : 'Filter by research direction'}>
          <button type="button" class="chip" data-filter="all" aria-pressed="true">{zh ? '全部' : 'All'}</button>
          {researchDirections.map((d) => (
            <button type="button" class="chip" data-filter={d.id} aria-pressed="false">{t(d.title, lang)}</button>
          ))}
        </div>
        {years.map((year) => (
          <div class="pub-year-group">
            <h3 class="year-head">{year}</h3>
            <ol class="bib">
              {pubs.filter((p) => p.year === year).map((paper) => <BibItem paper={paper} lang={lang} />)}
            </ol>
          </div>
        ))}
        <p class="pub-empty muted" hidden>{zh ? '这个方向暂无论文。' : 'No papers in this direction yet.'}</p>
      </div>
      <aside class="note">
        <p>{zh ? `共 ${pubs.length} 篇。加粗的作者是实验室成员。` : `${pubs.length} papers. Laboratory members are set in bold.`}</p>
      </aside>
    </div>
  </section>

  <section class="section" id="patents" aria-labelledby="h-patents">
    <div class="wrap row">
      <div class="main">
        <h2 class="section-title" id="h-patents">{t(ui.patents, lang)}</h2>
        {patents.length ? (
          <ol class="bib">
            {patents.map((p) => (
              <li class="bib-item">
                <div>
                  <h3 class="bib-title">{p.url ? <a href={p.url} target="_blank" rel="noopener">{p.title}</a> : p.title}</h3>
                  <p class="bib-authors">{p.inventors.split(/[,，]\s*/).map((n, i, a) => {
                    const text = n + (i < a.length - 1 ? '，' : '')
                    return p.lab?.includes(n.trim()) ? <b>{text}</b> : text
                  })}</p>
                  <p class="bib-meta">
                    {p.status === 'granted' ? (zh ? '发明专利授权' : 'Granted') : zh ? '发明专利公开' : 'Published application'}，{p.year}.
                    {p.number && <span class="bib-doi"> {p.number}</span>}
                  </p>
                </div>
              </li>
            ))}
          </ol>
        ) : (
          <p class="empty-state">{zh ? '专利信息正在整理，近期公布。' : 'Patent records are being compiled and will be published soon.'}</p>
        )}
      </div>
    </div>
  </section>
</Base>

<script>
  const buttons = document.querySelectorAll<HTMLButtonElement>('.pub-filter [data-filter]')
  const apply = (filter: string) => {
    buttons.forEach((b) => b.setAttribute('aria-pressed', String(b.dataset.filter === filter)))
    let shown = 0
    document.querySelectorAll<HTMLElement>('.pub-year-group').forEach((group) => {
      let visible = 0
      group.querySelectorAll<HTMLElement>('.bib-item').forEach((row) => {
        const ok = filter === 'all' || (row.dataset.directions ?? '').split(' ').includes(filter)
        row.hidden = !ok
        if (ok) visible++
      })
      group.hidden = visible === 0
      shown += visible
    })
    document.querySelector<HTMLElement>('.pub-empty')!.hidden = shown > 0
  }
  buttons.forEach((b) =>
    b.addEventListener('click', () => {
      const f = b.dataset.filter!
      apply(f)
      const url = new URL(location.href)
      f === 'all' ? url.searchParams.delete('direction') : url.searchParams.set('direction', f)
      history.replaceState(null, '', url)
    }),
  )
  const initial = new URLSearchParams(location.search).get('direction')
  if (initial && [...buttons].some((b) => b.dataset.filter === initial)) apply(initial)
</script>
