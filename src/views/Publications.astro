---
import Base from '../layouts/Base.astro'
import PageHeading from '../components/PageHeading.astro'
import PublicationRow from '../components/PublicationRow.astro'
import { publications, doiUrl } from '../data/publications'
import { researchDirections } from '../data/research'
import { ui, t, type Lang } from '../i18n'

interface Props {
  lang: Lang
}
const { lang } = Astro.props
const zh = lang === 'zh'
const years = [...new Set(publications.map((p) => p.year))].sort((a, b) => b - a)
const jsonLd = [
  {
    '@context': 'https://schema.org',
    '@graph': publications.map((p) => ({
      '@type': 'ScholarlyArticle',
      headline: p.title,
      datePublished: String(p.year),
      isPartOf: { '@type': 'Periodical', name: p.journal },
      sameAs: doiUrl(p.doi),
    })),
  },
]
---

<Base
  lang={lang}
  path="/publications/"
  title={t(ui.publications, lang)}
  description={zh ? '实验室在拓扑统计、复杂网络、数学生物学与科学智能方向的公开研究成果。' : 'Publications on topological statistics, complex networks, mathematical biology and AI for science.'}
  jsonLd={jsonLd}
>
  <PageHeading
    eyebrow="PUBLICATIONS"
    title={t(ui.publications, lang)}
    kicker={`${publications.length} ${zh ? '篇论文' : 'papers'}`}
    desc={zh ? '按年份排列，可按研究方向筛选。' : 'Listed by year; filter by research direction.'}
  />

  <section class="section publications-section pubs-page">
    <div class="page-shell">
      <div class="pub-filter" role="group" aria-label={zh ? '按研究方向筛选' : 'Filter by research direction'}>
        <button type="button" class="ph-chip active" data-filter="all" aria-pressed="true">{zh ? '全部' : 'All'}</button>
        {researchDirections.map((d) => (
          <button type="button" class="ph-chip" data-filter={d.id} aria-pressed="false">{t(d.title, lang)}</button>
        ))}
      </div>
      {years.map((year) => (
        <div class="pub-year-group" data-year={year}>
          <h2 class="pub-year">{year}</h2>
          <div class="publication-list">
            {publications.filter((p) => p.year === year).map((paper) => <PublicationRow paper={paper} lang={lang} />)}
          </div>
        </div>
      ))}
      <p class="pub-empty" hidden>{zh ? '该方向暂无条目。' : 'No entries for this direction yet.'}</p>
    </div>
  </section>
</Base>

<script>
  const buttons = document.querySelectorAll<HTMLButtonElement>('.pub-filter [data-filter]')
  const apply = (filter: string) => {
    buttons.forEach((b) => {
      const on = b.dataset.filter === filter
      b.classList.toggle('active', on)
      b.setAttribute('aria-pressed', String(on))
    })
    let shown = 0
    document.querySelectorAll<HTMLElement>('.pub-year-group').forEach((group) => {
      let visible = 0
      group.querySelectorAll<HTMLElement>('.publication-row').forEach((row) => {
        const ok = filter === 'all' || (row.dataset.directions ?? '').split(' ').includes(filter)
        row.hidden = !ok
        if (ok) visible++
      })
      group.hidden = visible === 0
      shown += visible
    })
    document.querySelector<HTMLElement>('.pub-empty')!.hidden = shown > 0
  }
  buttons.forEach((b) =>
    b.addEventListener('click', () => {
      const f = b.dataset.filter!
      apply(f)
      const url = new URL(location.href)
      f === 'all' ? url.searchParams.delete('direction') : url.searchParams.set('direction', f)
      history.replaceState(null, '', url)
    }),
  )
  const initial = new URLSearchParams(location.search).get('direction')
  if (initial && [...buttons].some((b) => b.dataset.filter === initial)) apply(initial)
</script>
