---
import Base from '../layouts/Base.astro'
import PageHeading from '../components/PageHeading.astro'
import BibItem from '../components/BibItem.astro'
import { sortedPublications as pubs, paperUrl } from '../data/publications'
import { sortedPatents as patents } from '../data/patents'
import { researchDirections } from '../data/research'
import allPapers from '../data/papers-all.json'
import names from '../data/people-names.json'
import { ui, t, type Lang } from '../i18n'

interface Props {
  lang: Lang
}
const { lang } = Astro.props
const zh = lang === 'zh'
const years = [...new Set(pubs.map((p) => p.year))].sort((a, b) => b - a)

// Full list (every paper by every member, from the lab's roster).
type Row = { y: number; t: string; a: [string, number][]; v: string; m: string[]; k?: string; pre?: number; ack?: number }
const rows = allPapers as Row[]
const allYears = [...new Set(rows.map((r) => r.y))].sort((a, b) => b - a)
const nameMap = names as Record<string, { zh: string; en: string }>
const counts = new Map<string, number>()
rows.forEach((r) => r.m.forEach((id) => counts.set(id, (counts.get(id) ?? 0) + 1)))
const authorOptions = [...counts.entries()]
  .filter(([id]) => nameMap[id])
  .sort((a, b) => b[1] - a[1] || nameMap[a[0]].en.localeCompare(nameMap[b[0]].en))
const jsonLd = [
  {
    '@context': 'https://schema.org',
    '@graph': pubs.map((p) => ({
      '@type': 'ScholarlyArticle',
      headline: p.title,
      datePublished: String(p.year),
      isPartOf: { '@type': 'Periodical', name: p.journal },
      ...(paperUrl(p) ? { sameAs: paperUrl(p) } : {}),
    })),
  },
]
---

<Base
  lang={lang}
  path="/publications/"
  title={t(ui.publications, lang)}
  description={zh ? '实验室成员近两年发表的论文与专利，覆盖拓扑统计、复杂网络、统计遗传与代数拓扑。' : 'Recent papers and patents by laboratory members in topological statistics, complex networks, statistical genetics and algebraic topology.'}
  jsonLd={jsonLd}
>
  <PageHeading
    lang={lang}
    title={t(ui.publications, lang)}
    lead={zh ? '署名本实验室的论文、实验室成员的全部论文与专利。' : 'Papers acknowledging the laboratory, plus all papers and patents by its members, past and present.'}
  />

  <section class="section" id="papers" aria-labelledby="h-papers" style="padding-top:clamp(32px,5vw,56px)">
    <div class="wrap row">
      <div class="main">
        <h2 class="section-title" id="h-papers">{zh ? '实验室署名论文' : 'Papers acknowledging the laboratory'}</h2>
        <div class="chips pub-filter" role="group" aria-label={zh ? '按研究方向筛选' : 'Filter by research direction'}>
          <button type="button" class="chip" data-filter="all" aria-pressed="true">{zh ? '全部' : 'All'}</button>
          {researchDirections.map((d) => (
            <button type="button" class="chip" data-filter={d.id} aria-pressed="false">{t(d.title, lang)}</button>
          ))}
        </div>
        {years.map((year) => (
          <div class="pub-year-group">
            <h3 class="year-head">{year}</h3>
            <ol class="bib">
              {pubs.filter((p) => p.year === year).map((paper) => <BibItem paper={paper} lang={lang} />)}
            </ol>
          </div>
        ))}
        <p class="pub-empty muted" hidden>{zh ? '这个方向暂无论文。' : 'No papers in this direction yet.'}</p>
      </div>
      <aside class="note">
        <p>{zh ? `${pubs.length} 篇作者单位中署名本实验室的论文（据实验室 2026 年成果核对）。加粗的作者是实验室成员。` : `${pubs.length} papers whose author affiliations name the laboratory (checked against the lab's 2026 achievement report). Laboratory members are set in bold.`}</p>
        <p><a class="link" href="#all-papers">{zh ? `全部论文（${rows.length} 篇）` : `All papers (${rows.length})`}</a></p>
      </aside>
    </div>
  </section>


  <section class="section" id="all-papers" aria-labelledby="h-all">
    <div class="wrap row">
      <div class="main">
        <h2 class="section-title" id="h-all">{zh ? '全部论文' : 'All papers'}</h2>
        <div class="all-filter">
          <label for="author-filter">{zh ? '按成员筛选' : 'Filter by member'}</label>
          <select id="author-filter">
            <option value="">{zh ? `全部成员（${rows.length} 篇）` : `All members (${rows.length})`}</option>
            {authorOptions.map(([id, n]) => <option value={id}>{nameMap[id][lang]}（{n}）</option>)}
          </select>
          <p class="all-count muted" aria-live="polite"></p>
        </div>
        {allYears.map((year) => (
          <div class="all-year-group">
            <h3 class="year-head">{year}</h3>
            <ol class="bib bib-compact">
              {rows.filter((r) => r.y === year).map((r) => (
                <li class="bib-item" data-m={r.m.join(' ')}>
                  <div>
                    <h3 class="bib-title">{r.t}</h3>
                    {r.a.length > 0 && <p class="bib-authors">{r.a.map(([n, lab], i) => {
                      const text = n + (i < r.a.length - 1 ? ', ' : '')
                      return lab ? <b>{text}</b> : text
                    })}</p>}
                    <p class="bib-meta"><i>{r.v}</i>, {r.y}.
                      {r.k === 'book' && <span class="bib-tag">{zh ? '著作' : 'Book'}</span>}
                      {r.pre && <span class="bib-tag">{zh ? '预印本' : 'Preprint'}</span>}
                      {r.ack && <span class="bib-tag bib-tag-lab">{zh ? '署名实验室' : 'Lab affiliation'}</span>}
                    </p>
                  </div>
                </li>
              ))}
            </ol>
          </div>
        ))}
      </div>
      <aside class="note">
        <p>{zh ? '收录实验室全体成员（含已离开的成员）2025 年以来的论文和著作，按年份排列，由成员自行申报。加粗的作者是实验室成员。' : 'Papers and books since 2025 by all laboratory members, including former members, as reported by the members. Laboratory members are set in bold.'}</p>
      </aside>
    </div>
  </section>

  <section class="section" id="patents" aria-labelledby="h-patents">
    <div class="wrap row">
      <div class="main">
        <h2 class="section-title" id="h-patents">{t(ui.patents, lang)}</h2>
        {patents.length ? (
          <ol class="bib">
            {patents.map((p) => (
              <li class="bib-item">
                <div>
                  <h3 class="bib-title">{p.url ? <a href={p.url} target="_blank" rel="noopener">{p.title}</a> : p.title}</h3>
                  <p class="bib-authors">{p.inventors.split(/[,，]\s*/).map((n, i, a) => {
                    const text = n + (i < a.length - 1 ? '，' : '')
                    return p.lab?.includes(n.trim()) ? <b>{text}</b> : text
                  })}</p>
                  <p class="bib-meta">
                    {p.status === 'granted' ? (zh ? '发明专利授权' : 'Granted patent') : p.status === 'filed' ? (zh ? '发明专利申请' : 'Patent application') : zh ? '发明专利申请公开' : 'Published application'}{zh ? '，' : ', '}{p.year}.
                    {p.number && <span class="bib-doi"> {p.number}</span>}
                    {p.note && <span>{zh ? p.note : ''}</span>}
                  </p>
                </div>
              </li>
            ))}
          </ol>
        ) : (
          <p class="empty-state">{zh ? '专利信息正在整理，近期公布。' : 'Patent records are being compiled and will be published soon.'}</p>
        )}
      </div>
    </div>
  </section>
</Base>

<script>
  const buttons = document.querySelectorAll<HTMLButtonElement>('.pub-filter [data-filter]')
  const apply = (filter: string) => {
    buttons.forEach((b) => b.setAttribute('aria-pressed', String(b.dataset.filter === filter)))
    let shown = 0
    document.querySelectorAll<HTMLElement>('.pub-year-group').forEach((group) => {
      let visible = 0
      group.querySelectorAll<HTMLElement>('.bib-item').forEach((row) => {
        const ok = filter === 'all' || (row.dataset.directions ?? '').split(' ').includes(filter)
        row.hidden = !ok
        if (ok) visible++
      })
      group.hidden = visible === 0
      shown += visible
    })
    document.querySelector<HTMLElement>('.pub-empty')!.hidden = shown > 0
  }
  buttons.forEach((b) =>
    b.addEventListener('click', () => {
      const f = b.dataset.filter!
      apply(f)
      const url = new URL(location.href)
      f === 'all' ? url.searchParams.delete('direction') : url.searchParams.set('direction', f)
      history.replaceState(null, '', url)
    }),
  )
  const initial = new URLSearchParams(location.search).get('direction')
  if (initial && [...buttons].some((b) => b.dataset.filter === initial)) apply(initial)

  // Full list: filter by member.
  const select = document.querySelector<HTMLSelectElement>('#author-filter')!
  const count = document.querySelector<HTMLElement>('.all-count')!
  const zh = document.documentElement.lang.startsWith('zh')
  const applyAuthor = (id: string) => {
    let shown = 0
    document.querySelectorAll<HTMLElement>('.all-year-group').forEach((group) => {
      let visible = 0
      group.querySelectorAll<HTMLElement>('.bib-item').forEach((row) => {
        const ok = !id || (row.dataset.m ?? '').split(' ').includes(id)
        row.hidden = !ok
        if (ok) visible++
      })
      group.hidden = visible === 0
      shown += visible
    })
    count.textContent = id ? (zh ? `${shown} 篇` : `${shown} papers`) : ''
  }
  select.addEventListener('change', () => {
    applyAuthor(select.value)
    const url = new URL(location.href)
    select.value ? url.searchParams.set('member', select.value) : url.searchParams.delete('member')
    history.replaceState(null, '', url)
  })
  const member = new URLSearchParams(location.search).get('member')
  if (member && [...select.options].some((o) => o.value === member)) {
    select.value = member
    applyAuthor(member)
  }
</script>
