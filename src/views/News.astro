---
import Base from '../layouts/Base.astro'
import PageHeading from '../components/PageHeading.astro'
import Timeline from '../components/Timeline.astro'
import { news, newsCategories } from '../data/news'
import { ui, t, type Lang } from '../i18n'

interface Props {
  lang: Lang
}
const { lang } = Astro.props
const zh = lang === 'zh'
---

<Base lang={lang} path="/news/" title={zh ? '动态' : 'News'} description={zh ? '实验室新闻动态、学术活动与研究进展。' : 'Laboratory news, academic events and research progress.'}>
  <PageHeading lang={lang} title={zh ? '动态' : 'News'} lead={zh ? '新闻、学术活动与研究进展。' : 'News, academic events and research progress.'} />

  {newsCategories.map((cat) => {
    const items = news.filter((n) => n.category === cat.id)
    return (
      <section class="section" id={cat.anchor} aria-labelledby={`h-${cat.anchor}`}>
        <div class="wrap row">
          <div class="main">
            <h2 class="section-title" id={`h-${cat.anchor}`}>{t(cat.title, lang)}</h2>
            {items.length ? <Timeline items={items} lang={lang} showKind={false} showSummary /> : <p class="muted">{zh ? '暂无内容。' : 'Nothing here yet.'}</p>}
          </div>
          <aside class="note"><p>{t(cat.desc, lang)}</p></aside>
        </div>
      </section>
    )
  })}
</Base>
