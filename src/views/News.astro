---
import Base from '../layouts/Base.astro'
import PageHeading from '../components/PageHeading.astro'
import Timeline from '../components/Timeline.astro'
import { news, events } from '../data/news'
import { ui, t, type Lang } from '../i18n'

interface Props {
  lang: Lang
}
const { lang } = Astro.props
const zh = lang === 'zh'
const research = news.filter((n) => n.research)
// Lab news plus news reports about activities; every title opens its own article.
const feed = [...news.filter((n) => !n.research), ...events.filter((e) => e.report)].sort((a, b) => b.date.localeCompare(a.date))
---

<Base lang={lang} path="/news/" title={t(ui.news, lang)} description={zh ? '复杂系统拓扑统计理论及应用北京市重点实验室新闻。' : 'News from the laboratory.'}>
  <PageHeading lang={lang} title={t(ui.news, lang)} lead={zh ? '实验室新闻、重要通知与研究成果报道。' : 'Laboratory news, announcements and research highlights.'} />
  <section class="section" style="padding-top:clamp(32px,5vw,56px)">
    <div class="wrap row">
      <div class="main">
        <h2 class="section-title">{zh ? '研究进展' : 'Research highlights'}</h2>
        <Timeline items={research} lang={lang} />
        <h2 class="section-title" style="margin-top:clamp(48px,7vw,80px)">{zh ? '新闻动态' : 'News'}</h2>
        <Timeline items={feed} lang={lang} />
      </div>
    </div>
  </section>
</Base>
