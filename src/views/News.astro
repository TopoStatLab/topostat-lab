---
import Base from '../layouts/Base.astro'
import PageHeading from '../components/PageHeading.astro'
import MediaCard from '../components/MediaCard.astro'
import { news, events } from '../data/news'
import { media } from '../data/media'
import { ui, t, type Lang } from '../i18n'

interface Props {
  lang: Lang
}
const { lang } = Astro.props
const zh = lang === 'zh'
const research = news.filter((n) => n.research)
// Lab news plus news reports about activities; every title opens its own article.
const feed = [...news.filter((n) => !n.research), ...events.filter((e) => e.report)].sort((a, b) => b.date.localeCompare(a.date))
---

<Base lang={lang} path="/news/" title={t(ui.news, lang)} description={zh ? '复杂系统拓扑统计理论及应用北京市重点实验室新闻。' : 'News from the laboratory.'}>
  <PageHeading lang={lang} image={media.campusSign} title={t(ui.news, lang)} lead={zh ? '实验室新闻、学术活动报道与研究成果。' : 'Laboratory news, event reports and research highlights.'} />
  <section class="section section-white" aria-labelledby="h-research">
    <div class="wrap">
      <div class="sec-head"><h2 class="section-title" id="h-research">{zh ? '研究进展' : 'Research highlights'}</h2></div>
      <div class="mgrid">{research.map((n) => <MediaCard item={n} lang={lang} detail />)}</div>
    </div>
  </section>
  <section class="section section-tint" aria-labelledby="h-feed">
    <div class="wrap">
      <div class="sec-head"><h2 class="section-title" id="h-feed">{zh ? '新闻动态' : 'News'}</h2></div>
      <div class="mgrid">{feed.map((n) => <MediaCard item={n} lang={lang} label={'place' in n ? (zh ? '活动报道' : 'Event report') : undefined} detail />)}</div>
    </div>
  </section>
</Base>
