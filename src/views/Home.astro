---
import Base from '../layouts/Base.astro'
import NetworkCanvas from '../components/NetworkCanvas.astro'
import SectionHeading from '../components/SectionHeading.astro'
import PublicationRow from '../components/PublicationRow.astro'
import NewsGrid from '../components/NewsGrid.astro'
import Portrait from '../components/Portrait.astro'
import { researchDirections, concepts, applications } from '../data/research'
import { publications } from '../data/publications'
import { leader, director, members } from '../data/people'
import { site } from '../data/site'
import { ui, t, localizedPath, type Lang } from '../i18n'

interface Props {
  lang: Lang
}
const { lang } = Astro.props
const L = (p: string) => localizedPath(p, lang)
const zh = lang === 'zh'
---

<Base lang={lang} path="/" heroHeader>
  <section class="hero">
    <NetworkCanvas />
    <div class="hero-grid" aria-hidden="true"></div>
    <div class="hero-aurora aurora-a" aria-hidden="true"></div>
    <div class="hero-aurora aurora-b" aria-hidden="true"></div>
    <div class="hero-orbit orbit-a" aria-hidden="true"></div>
    <div class="hero-orbit orbit-b" aria-hidden="true"></div>
    <div class="hero-vignette" aria-hidden="true"></div>

    <div class="hero-content page-shell">
      <div class="hero-kicker"><span></span> BEIJING KEY LABORATORY</div>
      {zh ? (
        <h1>复杂系统<br /><em>拓扑统计</em>理论及应用</h1>
      ) : (
        <h1 class="hero-title-en"><em>Topological Statistics</em><br />for Complex Systems</h1>
      )}
      <p class="hero-en">{zh ? ui.siteName.en : ui.siteName.zh}</p>
      <p class="hero-lead">{zh ? '从非欧数据中发现结构，从复杂系统中提炼规律。' : 'Finding structure in non-Euclidean data; distilling laws from complex systems.'}</p>
      <div class="hero-actions">
        <a class="button primary" href={L('/research/')}>{zh ? '探索研究' : 'Explore research'} <span aria-hidden="true">↗</span></a>
        <a class="button ghost" href={L('/research/#demo')}>{zh ? '动手体验拓扑统计' : 'Try the interactive demo'}</a>
      </div>
    </div>

    <div class="hero-bottom page-shell">
      <div class="institution-strip">
        <span>{t(ui.hostedBy, lang)}</span>
        <strong>{zh ? `${site.hostInstitution.zh} · BIMSA` : site.hostInstitution.en}</strong>
        <i></i>
        <span>{t(ui.coBuiltWith, lang)}</span>
        <strong>{site.partnerInstitution[lang]}</strong>
      </div>
      <a href="#mission" class="scroll-hint">SCROLL <span aria-hidden="true">↓</span></a>
    </div>
  </section>

  <section class="intro-band anchor-target" id="mission">
    <div class="page-shell intro-layout">
      <p class="intro-index">01 / MISSION</p>
      <div class="intro-copy">
        <p>{zh ? '面向大数据与人工智能时代的复杂性挑战' : 'Meeting the complexity challenges of the big-data and AI era'}</p>
        <h2>{zh ? '建立连接统计、拓扑、网络与真实世界复杂系统的新理论。' : 'Building new theory that connects statistics, topology, networks and real-world complex systems.'}</h2>
      </div>
      <div class="intro-stats">
        <div><strong>3</strong><span>{zh ? '核心研究方向' : 'core research directions'}</span></div>
        <div><strong>{site.founded}</strong><span>{zh ? '正式挂牌成立' : 'officially established'}</span></div>
        <div><strong>2</strong><span>{zh ? '依托与共建单位' : 'host & partner institutions'}</span></div>
      </div>
    </div>
  </section>

  <section class="section research-section">
    <div class="page-shell">
      <SectionHeading
        eyebrow="SCIENTIFIC RESEARCH"
        title={t(ui.research, lang)}
        desc={zh ? '围绕复杂系统的结构、动力学与高阶互作，形成从理论创新到计算方法再到真实应用的研究链条。' : 'From theory to computation to real-world application — studying the structure, dynamics and higher-order interactions of complex systems.'}
      />
      <div class="research-grid">
        {researchDirections.map((item, i) => (
          <a class="research-card" href={L(`/research/#${item.id}`)}>
            <div class="research-top">
              <span class="research-index">{String(i + 1).padStart(2, '0')}</span>
              <span class="research-arrow" aria-hidden="true">↗</span>
            </div>
            <p class="research-en">{item.en}</p>
            <h3>{t(item.title, lang)}</h3>
            <p class="research-body">{t(item.body, lang)}</p>
            <div class="tag-row">{item.tags.map((tag) => <span>{tag}</span>)}</div>
          </a>
        ))}
      </div>
    </div>
  </section>

  <section class="science-visual section-dark">
    <div class="page-shell visual-layout">
      <div class="visual-copy">
        <SectionHeading
          eyebrow="THEORY × DATA × INTELLIGENCE"
          title={zh ? '拓扑，让复杂数据显露形状' : 'Topology reveals the shape of data'}
          desc={zh ? '传统统计主要在欧氏空间中寻找规律，而现代复杂系统往往天然表现为网络、流形与高阶结构。实验室试图把这些“形状”本身纳入统计推断。' : 'Classical statistics looks for patterns in Euclidean space, yet modern complex systems naturally take the form of networks, manifolds and higher-order structures. We bring that shape itself into statistical inference.'}
          light
        />
        <div class="concept-list">
          {concepts.map((c, i) => <span><b>{String(i + 1).padStart(2, '0')}</b> {t(c, lang)}</span>)}
        </div>
        <a class="button primary visual-cta" href={L('/research/#demo')}>{zh ? '动手试一试：持续同调演示' : 'Try it: persistent homology demo'} <span aria-hidden="true">→</span></a>
      </div>
      <div class="topology-figure" aria-hidden="true">
        <div class="topology-ring ring-1"></div>
        <div class="topology-ring ring-2"></div>
        <div class="topology-ring ring-3"></div>
        <div class="topology-core">T</div>
        {Array.from({ length: 12 }).map((_, i) => <i style={`--i:${i}`}></i>)}
        <p>TOPOLOGY<br />STATISTICS<br />COMPLEXITY</p>
      </div>
    </div>
  </section>

  <section class="section publications-section">
    <div class="page-shell">
      <div class="split-heading">
        <SectionHeading eyebrow="SELECTED OUTPUTS" title={t(ui.publications, lang)} />
        <p>
          {zh ? '持续更新实验室在拓扑统计、复杂网络、数学生物学与科学智能方向的公开研究成果。' : 'Recent work on topological statistics, complex networks, mathematical biology and AI for science.'}
          <a class="text-link" href={L('/publications/')}>{t(ui.viewAll, lang)} →</a>
        </p>
      </div>
      <div class="publication-list">
        {publications.slice(0, 3).map((paper) => <PublicationRow paper={paper} lang={lang} />)}
      </div>
    </div>
  </section>

  <section class="applications-section">
    <div class="page-shell">
      <SectionHeading eyebrow="APPLICATIONS" title={zh ? '从数学理论走向复杂世界' : 'From mathematics to the complex world'} />
      <div class="application-grid">
        {applications.map((app, i) => (
          <article class="application-card">
            <span>{String(i + 1).padStart(2, '0')}</span>
            <p>{app.en}</p>
            <h3>{t(app.title, lang)}</h3>
            <div class="application-line"></div>
            <small>{t(app.body, lang)}</small>
          </article>
        ))}
      </div>
    </div>
  </section>

  <section class="section team-teaser">
    <div class="page-shell team-teaser-layout">
      <div>
        <SectionHeading
          eyebrow="RESEARCH TEAM"
          title={t(ui.team, lang)}
          desc={zh ? `实验室汇聚数学、统计、物理与生命科学等领域的 ${members.length + 2} 位核心成员，以跨学科协同组织研究力量。` : `${members.length + 2} core members across mathematics, statistics, physics and the life sciences, organised around interdisciplinary collaboration.`}
        />
        <a class="button dark" href={L('/team/')}>{zh ? '查看研究团队' : 'Meet the team'} <span aria-hidden="true">→</span></a>
      </div>
      <div class="team-teaser-faces">
        {[leader, director, ...members.slice(0, 6)].map((p) => (
          <a href={L(`/team/#${p.id}`)} class="team-teaser-face" title={p.name[lang]}>
            <Portrait person={p} lang={lang} />
          </a>
        ))}
      </div>
    </div>
  </section>

  <section class="section news-section">
    <div class="page-shell">
      <div class="split-heading">
        <SectionHeading eyebrow="NEWS & EVENTS" title={t(ui.news, lang)} />
        <p><a class="text-link" href={L('/news/')}>{t(ui.viewAll, lang)} →</a></p>
      </div>
      <NewsGrid lang={lang} limit={2} />
    </div>
  </section>

  <section id="about" class="about-section section-dark anchor-target">
    <div class="page-shell about-layout">
      <div>
        <p class="about-kicker">ABOUT THE LABORATORY</p>
        <h2>{zh ? '理论 — 应用 — 转化' : 'Theory — Application — Translation'}</h2>
      </div>
      <div class="about-copy">
        {zh ? (
          <>
            <p>复杂系统拓扑统计理论及应用北京市重点实验室依托北京雁栖湖应用数学研究院建设，与中国人民大学数学学院联合共建。</p>
            <p>实验室聚焦应用数学中的拓扑统计方向，围绕国家重大需求与现代复杂数据分析挑战，推动统计学与拓扑学、统计物理、图论、进化博弈论等分支交叉融合，建设从理论方法、计算软件到跨领域应用的完整研究链条。</p>
          </>
        ) : (
          <>
            <p>The Beijing Key Laboratory of Topological Statistics and Applications for Complex Systems is hosted by the Beijing Institute of Mathematical Sciences and Applications (BIMSA) and co-built with the School of Mathematics at Renmin University of China.</p>
            <p>Focusing on topological statistics within applied mathematics, the laboratory brings statistics together with topology, statistical physics, graph theory and evolutionary game theory to address national strategic needs and the challenges of modern complex data — building a complete chain from theory and methods to computational software and cross-disciplinary applications.</p>
          </>
        )}
        <div class="about-links">
          <a href={site.hostInstitution.url} target="_blank" rel="noopener">BIMSA ↗</a>
          <a href="https://kw.beijing.gov.cn/xwdt/kcyx/xwdtscyqld/202502/t20250214_4010193.html" target="_blank" rel="noopener">{zh ? '成立公告' : 'Establishment notice'} ↗</a>
        </div>
      </div>
    </div>
  </section>

  <section class="contact-section">
    <div class="page-shell contact-layout">
      <div class="contact-title">
        <p>CONTACT</p>
        <h2>{t(ui.contact, lang)}</h2>
        <a class="button dark contact-more" href={L('/contact/')}>{zh ? '联系方式与交通' : 'Contact & directions'} <span aria-hidden="true">→</span></a>
      </div>
      <div class="contact-cards">
        {site.contact.locations.map((loc) => (
          <article class="contact-card">
            <span>{t(loc.tag, lang)}</span>
            <h3>{t(loc.name, lang)}</h3>
            <p>{t(loc.address, lang)}</p>
          </article>
        ))}
      </div>
    </div>
  </section>
</Base>
