---
import Base from '../layouts/Base.astro'
import HeroFigure from '../components/HeroFigure.astro'
import BibItem from '../components/BibItem.astro'
import Timeline from '../components/Timeline.astro'
import Portrait from '../components/Portrait.astro'
import { researchDirections, applications } from '../data/research'
import { publications, doiUrl } from '../data/publications'
import { news } from '../data/news'
import { leader, director, members } from '../data/people'
import { site } from '../data/site'
import { ui, t, localizedPath, type Lang } from '../i18n'

interface Props {
  lang: Lang
}
const { lang } = Astro.props
const L = (p: string) => localizedPath(p, lang)
const zh = lang === 'zh'
const amap = (q: string) => `https://uri.amap.com/search?keyword=${encodeURIComponent(q)}&city=110000`
---

<Base lang={lang} path="/">
  <HeroFigure lang={lang} />

  <section class="section" id="research" aria-labelledby="h-research">
    <div class="wrap row">
      <div class="main">
        <h2 class="section-title" id="h-research">{zh ? '研究方向' : 'Research'}</h2>
        <p class="section-lead">
          {zh
            ? '传统统计在欧氏空间中寻找规律，而现代复杂系统天然表现为网络、流形与高阶结构。我们把这些“形状”本身纳入统计推断。'
            : 'Classical statistics looks for patterns in Euclidean space; modern complex systems come as networks, manifolds and higher-order structures. We make that shape part of statistical inference.'}
        </p>
      </div>
    </div>
    {researchDirections.map((d) => {
      const papers = publications.filter((p) => p.directions.includes(d.id))
      return (
        <div class="wrap row">
          <article class="main direction">
            <h3><a href={L(`/research/#${d.id}`)}>{t(d.title, lang)}</a></h3>
            <p>{t(d.body, lang)}</p>
            <p class="keywords">{d.tags.join(zh ? '，' : ', ')}</p>
          </article>
          <aside class="note direction-note">
            <h4>{zh ? '相关论文' : 'Related papers'}</h4>
            {papers.length ? (
              <ul>
                {papers.map((p) => (
                  <li><a href={doiUrl(p.doi)} target="_blank" rel="noopener">{p.title}</a><br /><i>{p.journal}</i>, {p.year}</li>
                ))}
              </ul>
            ) : (
              <p>{zh ? '即将更新。' : 'Coming soon.'}</p>
            )}
          </aside>
        </div>
      )
    })}
  </section>

  <section class="section" id="publications" aria-labelledby="h-pubs">
    <div class="wrap row">
      <div class="main">
        <h2 class="section-title" id="h-pubs">{zh ? '近期论文' : 'Recent papers'}</h2>
        <ol class="bib">
          {publications.slice(0, 5).map((paper) => <BibItem paper={paper} lang={lang} />)}
        </ol>
      </div>
      <aside class="note">
        <p>{zh ? `共 ${publications.length} 篇，可按研究方向筛选。` : `${publications.length} papers, filterable by research direction.`}</p>
        <a href={L('/publications/')}>{zh ? '查看全部论文' : 'All papers'}</a>
      </aside>
    </div>
  </section>

  <section class="section" id="applications" aria-labelledby="h-apps">
    <div class="wrap row">
      <div class="main">
        <h2 class="section-title" id="h-apps">{zh ? '用在哪里' : 'Where it applies'}</h2>
        <dl class="apps">
          {applications.map((app) => (
            <div>
              <dt>{t(app.title, lang)}</dt>
              <dd>{t(app.body, lang)}</dd>
            </div>
          ))}
        </dl>
      </div>
    </div>
  </section>

  <section class="section" id="people" aria-labelledby="h-people">
    <div class="wrap row">
      <div class="main">
        <h2 class="section-title" id="h-people">{t(ui.team, lang)}</h2>
      </div>
      <aside class="note">
        <p>{zh ? `${members.length + 2} 位成员，来自数学、统计、物理与生命科学。` : `${members.length + 2} members from mathematics, statistics, physics and the life sciences.`}</p>
        <a href={L('/team/')}>{zh ? '查看团队' : 'Meet the team'}</a>
      </aside>
    </div>
    <div class="wrap">
      <ul class="people">
        {[leader, director, ...members].map((p) => (
          <li class="person">
            <a href={L(`/team/#${p.id}`)}>
              <Portrait person={p} lang={lang} />
              <p class="person-name">{p.name[lang]}</p>
              {p.title && <p class="person-meta">{t(p.title, lang)}</p>}
            </a>
          </li>
        ))}
      </ul>
    </div>
  </section>

  <section class="section" id="news" aria-labelledby="h-news">
    <div class="wrap row">
      <div class="main">
        <h2 class="section-title" id="h-news">{zh ? '动态' : 'News'}</h2>
        <Timeline items={news.slice(0, 5)} lang={lang} />
      </div>
      <aside class="note">
        <p>{zh ? '新闻、学术活动与研究进展。' : 'News, academic events and research progress.'}</p>
        <a href={L('/news/')}>{zh ? '查看全部动态' : 'All news'}</a>
      </aside>
    </div>
  </section>

  <section class="section" id="about" aria-labelledby="h-about">
    <div class="wrap row">
      <div class="main about">
        <h2 class="section-title" id="h-about">{zh ? '关于实验室' : 'About'}</h2>
        {zh ? (
          <>
            <p>复杂系统拓扑统计理论及应用北京市重点实验室依托北京雁栖湖应用数学研究院建设，与中国人民大学数学学院联合共建，于 2025 年挂牌成立。</p>
            <p>实验室聚焦应用数学中的拓扑统计方向，推动统计学与拓扑学、统计物理、图论、进化博弈论交叉融合，建设从理论方法、计算软件到跨领域应用的完整研究链条。</p>
          </>
        ) : (
          <>
            <p>The Beijing Key Laboratory of Topological Statistics and Applications for Complex Systems is hosted by BIMSA and co-built with the School of Mathematics at Renmin University of China. It was established in 2025.</p>
            <p>The laboratory brings statistics together with topology, statistical physics, graph theory and evolutionary game theory, building a chain from theory and methods to software and cross-disciplinary applications.</p>
          </>
        )}
        <p><a class="link" href="https://kw.beijing.gov.cn/xwdt/kcyx/xwdtscyqld/202502/t20250214_4010193.html" target="_blank" rel="noopener">{zh ? '北京市科委成立公告' : 'Establishment announcement (in Chinese)'}</a></p>
      </div>
      <aside class="note addresses">
        {site.contact.locations.map((loc) => (
          <div>
            <h3>{t(loc.name, lang)}</h3>
            <p>{t(loc.address, lang)}</p>
            <a href={amap(loc.mapQuery)} target="_blank" rel="noopener">{t(ui.openMap, lang)}</a>
          </div>
        ))}
        {site.contact.email && <div><h3>{t(ui.email, lang)}</h3><p><a href={`mailto:${site.contact.email}`}>{site.contact.email}</a></p></div>}
      </aside>
    </div>
  </section>
</Base>
