---
import Base from '../layouts/Base.astro'
import Contours from '../components/Contours.astro'
import Picture from '../components/Picture.astro'
import Portrait from '../components/Portrait.astro'
import { researchDirections } from '../data/research'
import { sortedPublications, paperUrl } from '../data/publications'
import { news, events, formatDate, formatRange, type NewsItem, type EventItem } from '../data/news'
import { director, deputies, committeeChair, members } from '../data/people'
import { media } from '../data/media'
import { site } from '../data/site'
import { ui, t, localizedPath, type Lang } from '../i18n'

interface Props {
  lang: Lang
}
const { lang } = Astro.props
const L = (p: string) => localizedPath(p, lang)
const zh = lang === 'zh'
/** Internal links stay in the site (and its language); others open a new tab. */
const go = (h?: string) => (!h ? {} : h.startsWith('/') ? { href: L(h) } : { href: h, target: '_blank', rel: 'noopener' })
const when = (x: NewsItem | EventItem) => ('until' in x && x.until ? formatRange(x.date, x.until, lang) : formatDate(x.date, lang))

const latest = [...news, ...events.filter((e) => e.report)].sort((a, b) => b.date.localeCompare(a.date))
const lead = latest.find((x) => x.image)!
const headlines = latest.slice(0, 6)
const recentEvents = events.slice(0, 6)
const papers = sortedPublications.slice(0, 3)
const marks = [
  '<g stroke="currentColor" stroke-width="1" fill="none"><path d="M30 90 90 40 150 80 210 30 270 85 150 80 90 40"/></g><g fill="currentColor"><circle cx="30" cy="90" r="3.5"/><circle cx="90" cy="40" r="3.5"/><circle cx="210" cy="30" r="3.5"/><circle cx="270" cy="85" r="3.5"/></g><circle cx="150" cy="80" r="6" fill="var(--red)"/>',
  '<g fill="none" stroke="currentColor" stroke-width="1">' + [0, 1, 2, 3, 4, 5].map((k) => `<ellipse cx="150" cy="60" rx="${120 - k * 16}" ry="${48 - k * 6.5}" stroke-opacity="${(0.25 + k * 0.12).toFixed(2)}"/>`).join('') + '</g><ellipse cx="150" cy="60" rx="40" ry="14" fill="none" stroke="var(--red)" stroke-width="1.6"/>',
  '<g fill="none" stroke="currentColor" stroke-width="1"><path d="M150 12 250 104 50 104Z M150 12 170 74 50 104 M170 74 250 104"/></g><path d="M150 12 250 104 170 74Z" fill="var(--red)" fill-opacity=".85"/>',
]
const amap = (q: string) => `https://uri.amap.com/search?keyword=${encodeURIComponent(q)}&city=110000`
---

<Base lang={lang} path="/">
  <section class="e-hero" aria-labelledby="h-site">
    <Contours seed={1} variant="hero" />
    <div class="wrap e-hero-grid">
      <p class="e-seal" aria-hidden="true"><i>{zh ? '拓扑' : 'Topo'}<br />{zh ? '统计' : 'Stat'}</i><span>{zh ? '雁栖湖畔' : 'Yanqi Lake'}</span></p>
      <div>
        {zh ? (
          <h1 id="h-site" class="e-title">复杂系统拓扑统计<br />理论及应用<br />北京市重点实验室</h1>
        ) : (
          <h1 id="h-site" class="e-title e-title-en">Beijing Key Laboratory of Topological Statistics and Applications for Complex Systems</h1>
        )}
        <p class="e-sub">{zh ? ui.siteName.en : ui.siteName.zh}</p>
        <p class="e-lead">{zh ? '依托北京雁栖湖应用数学研究院（BIMSA）建设，与中国人民大学数学学院联合共建。实验室把拓扑学引入统计推断，研究网络、流形与高阶互作中的“形状”，并把它用于生物医学、人工智能与真实世界的复杂系统。' : 'Hosted by the Beijing Institute of Mathematical Sciences and Applications (BIMSA) and co-built with the School of Mathematics, Renmin University of China. We bring topology into statistical inference, studying the shape of networks, manifolds and higher-order interactions, and apply it to biomedicine, AI and real-world complex systems.'}</p>
        <div class="e-cta"><a class="btn" href={L('/about/')}>{zh ? '了解实验室' : 'About the lab'}</a><a class="e-textlink" href={L('/research/')}>{zh ? '研究方向' : 'Research'}</a></div>
      </div>
    </div>
  </section>

  <div class="e-facts">
    <div class="wrap">
      <div><b>2025</b><span>{zh ? '挂牌成立' : 'Established'}</span></div>
      <div><b>{members.length + 2}</b><span>{zh ? '研究人员与学生' : 'Researchers and students'}</span></div>
      <div><b>{sortedPublications.length}</b><span>{zh ? '署名实验室论文' : 'Papers acknowledging the lab'}</span></div>
      <div><b>{events.length}</b><span>{zh ? '学术活动' : 'Academic events'}</span></div>
    </div>
  </div>

  <section class="wrap vsec" aria-labelledby="h-news">
    <h2 class="vlabel" id="h-news">{zh ? '科研动态' : 'News'}<small>{zh ? 'News' : ''}</small></h2>
    <div>
      <div class="e-news">
        <a class="e-figure" {...go(lead.href)}>
          <Picture image={lead.image!} alt={lead.image!.alt[lang]} sizes="(max-width: 960px) 100vw, 560px" />
          <span class="e-figcap">{t(lead.title, lang)}</span>
        </a>
        <ul class="e-list">
          {headlines.map((x) => (
            <li>
              <a {...go(x.href)}>
                <time class="e-date" datetime={x.date}>{when(x)}</time>
                <h3>{t(x.title, lang)}</h3>
              </a>
            </li>
          ))}
        </ul>
      </div>
      <a class="e-more" href={L('/news/')}>{zh ? '全部新闻' : 'All news'}</a>
    </div>
  </section>

  <section class="wrap vsec" aria-labelledby="h-events">
    <h2 class="vlabel" id="h-events">{zh ? '学术活动' : 'Events'}<small>{zh ? 'Events' : ''}</small></h2>
    <div>
      <ul class="e-events">
        {recentEvents.map((e) => (
          <li>
            <time class="e-date" datetime={e.date}>{when(e)}</time>
            <div>
              <h3>{e.href ? <a {...go(e.href)}>{t(e.title, lang)}</a> : t(e.title, lang)}</h3>
              <p>{t(e.place, lang)}</p>
            </div>
          </li>
        ))}
      </ul>
      <a class="e-more" href={L('/events/')}>{zh ? '全部学术活动与报告' : 'All events and talks'}</a>
    </div>
  </section>

  <section class="wrap vsec" aria-labelledby="h-research">
    <h2 class="vlabel" id="h-research">{zh ? '研究方向' : 'Research'}<small>{zh ? 'Research' : ''}</small></h2>
    <div class="e-dirs">
      {researchDirections.map((d, i) => (
        <a class="e-dir" href={L(`/research/#${d.id}`)}>
          <svg viewBox="0 0 300 120" aria-hidden="true" set:html={marks[i % marks.length]} />
          <h3>{t(d.title, lang)}</h3>
          <p>{t(d.body, lang)}</p>
        </a>
      ))}
    </div>
  </section>

  <section class="wrap vsec" aria-labelledby="h-pubs">
    <h2 class="vlabel" id="h-pubs">{zh ? '署名论文' : 'Papers'}<small>{zh ? 'Papers' : ''}</small></h2>
    <div>
      <ul class="e-pubs">
        {papers.map((p) => (
          <li>
            <div>
              <h3>{paperUrl(p) ? <a href={paperUrl(p)} target="_blank" rel="noopener">{p.title}</a> : p.title}</h3>
              {p.authors && <p>{p.authors}</p>}
            </div>
            <p class="e-journal"><b>{p.year}</b>{p.journal}</p>
          </li>
        ))}
      </ul>
      <a class="e-more" href={L('/publications/')}>{zh ? `全部 ${sortedPublications.length} 篇署名论文与专利` : `All ${sortedPublications.length} papers and patents`}</a>
    </div>
  </section>

  <section class="wrap vsec" aria-labelledby="h-people">
    <h2 class="vlabel" id="h-people">{zh ? '学术带头人' : 'People'}<small>{zh ? 'People' : ''}</small></h2>
    <div>
      <a class="e-chair" href={L(`/about/#${committeeChair.id}`)}>
        <Portrait person={committeeChair} lang={lang} />
        <div>
          <p class="e-role">{committeeChair.role && t(committeeChair.role, lang)}</p>
          <h3>{committeeChair.name[lang]}</h3>
          {committeeChair.title && <p>{t(committeeChair.title, lang)}</p>}
          <p class="e-chair-note">{zh ? '菲尔兹奖、沃尔夫数学奖、克拉福德奖获得者，美国国家科学院院士。' : 'Fields Medal, Wolf Prize in Mathematics and Crafoord Prize laureate; member of the US National Academy of Sciences.'}</p>
        </div>
      </a>
      <ul class="e-people">
        {[director, ...deputies].map((p) => (
          <li>
            <a href={L(`/about/#${p.id}`)}>
              <Portrait person={p} lang={lang} />
              <h3>{p.name[lang]}</h3>
              {p.role && <p class="e-role">{t(p.role, lang)}</p>}
              {p.title && <p>{t(p.title, lang)}</p>}
            </a>
          </li>
        ))}
      </ul>
      <a class="e-more" href={L('/about/#organization')}>{zh ? '组织架构与学术委员会' : 'Organization and committee'}</a>
    </div>
  </section>

  <section class="e-about" aria-labelledby="h-about">
    <Picture image={media.campusMountain} alt={media.campusMountain.alt[lang]} sizes="100vw" />
    <div class="e-about-card">
      <h2 id="h-about">{zh ? '关于实验室' : 'About the laboratory'}</h2>
      <p>{zh ? '2025 年挂牌成立，依托北京雁栖湖应用数学研究院建设，与中国人民大学数学学院联合共建。' : 'Established in 2025, hosted by BIMSA and co-built with the School of Mathematics, Renmin University of China.'}</p>
      {site.contact.locations.map((loc) => (
        <p class="e-addr"><b>{t(loc.name, lang)}</b>{t(loc.address, lang)}　<a href={amap(loc.mapQuery)} target="_blank" rel="noopener">{t(ui.openMap, lang)}</a></p>
      ))}
    </div>
  </section>
</Base>
