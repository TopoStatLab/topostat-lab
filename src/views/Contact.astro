---
import Base from '../layouts/Base.astro'
import PageHeading from '../components/PageHeading.astro'
import { site } from '../data/site'
import { ui, t, type Lang } from '../i18n'

interface Props {
  lang: Lang
}
const { lang } = Astro.props
const zh = lang === 'zh'
const amap = (q: string) => `https://uri.amap.com/search?keyword=${encodeURIComponent(q)}&city=110000`
---

<Base lang={lang} path="/contact/" title={t(ui.contact, lang)} description={zh ? '复杂系统拓扑统计理论及应用北京市重点实验室联系方式与地址。' : 'Contact details and addresses of the laboratory.'}>
  <PageHeading lang={lang} title={t(ui.contact, lang)} />

  <section class="section" style="padding-top:clamp(32px,5vw,56px)">
    <div class="wrap row">
      <div class="main">
        <dl class="apps">
          {site.contact.locations.map((loc) => (
            <div>
              <dt>{t(loc.name, lang)}</dt>
              <dd>
                {t(loc.address, lang)}<br />
                <a class="link" href={amap(loc.mapQuery)} target="_blank" rel="noopener">{t(ui.openMap, lang)}</a>
              </dd>
            </div>
          ))}
          {(site.contact.email || site.contact.phone) && (
            <div>
              <dt>{zh ? '联系方式' : 'Get in touch'}</dt>
              <dd>
                {site.contact.email && <>{t(ui.email, lang)}：<a class="link" href={`mailto:${site.contact.email}`}>{site.contact.email}</a><br /></>}
                {site.contact.phone && <>{t(ui.phone, lang)}：<a class="link" href={`tel:${site.contact.phone.replace(/\s/g, '')}`}>{site.contact.phone}</a></>}
              </dd>
            </div>
          )}
        </dl>
      </div>
    </div>
  </section>
</Base>
