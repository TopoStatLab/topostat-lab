---
import Base from '../layouts/Base.astro'
import PageHeading from '../components/PageHeading.astro'
import { site } from '../data/site'
import { ui, t, type Lang } from '../i18n'

interface Props {
  lang: Lang
}
const { lang } = Astro.props
const zh = lang === 'zh'
const amap = (q: string) => `https://uri.amap.com/search?keyword=${encodeURIComponent(q)}&city=110000`
---

<Base lang={lang} path="/contact/" title={t(ui.contact, lang)} description={zh ? '复杂系统拓扑统计理论及应用北京市重点实验室联系方式与地址。' : 'Contact details and addresses of the laboratory.'}>
  <PageHeading eyebrow="CONTACT" title={t(ui.contact, lang)} />

  <section class="contact-section contact-page">
    <div class="page-shell">
      <div class="contact-cards contact-cards-wide">
        {site.contact.locations.map((loc) => (
          <article class="contact-card">
            <span>{t(loc.tag, lang)}</span>
            <h2>{t(loc.name, lang)}</h2>
            <p>{t(loc.address, lang)}</p>
            <a class="contact-map" href={amap(loc.mapQuery)} target="_blank" rel="noopener">{t(ui.openMap, lang)} ↗</a>
          </article>
        ))}
        {(site.contact.email || site.contact.phone) && (
          <article class="contact-card">
            <span>GET IN TOUCH</span>
            <h2>{zh ? '联系方式' : 'Get in touch'}</h2>
            {site.contact.email && <p>{t(ui.email, lang)}：<a href={`mailto:${site.contact.email}`}>{site.contact.email}</a></p>}
            {site.contact.phone && <p>{t(ui.phone, lang)}：<a href={`tel:${site.contact.phone.replace(/\s/g, '')}`}>{site.contact.phone}</a></p>}
          </article>
        )}
      </div>
    </div>
  </section>
</Base>
