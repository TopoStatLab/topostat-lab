---
import Base from '../layouts/Base.astro'
import PageHeading from '../components/PageHeading.astro'
import { visiting } from '../data/visiting'
import { ui, t, type Lang } from '../i18n'

interface Props {
  lang: Lang
}
const { lang } = Astro.props
const zh = lang === 'zh'
// The portrait wall (components/PortraitCloud.astro) is hidden for now at the
// lab's request; it can come back once most scholars have photos.
---

<Base lang={lang} path="/visitors/" title={t(ui.visitors, lang)} description={zh ? '曾在实验室访学的学者与学生，以及他们后来的去向。' : 'Past visiting scholars and students of the laboratory, and where they are now.'}>
  <PageHeading lang={lang} title={t(ui.visitors, lang)} lead={zh ? `曾在实验室访学的 ${visiting.length} 位学者与学生，以及他们现在的去向。` : `${visiting.length} scholars and students who have visited the laboratory, and where they are now.`} />

  <section class="section" aria-label={zh ? '往届访问学者' : 'Past visiting scholars'} style="padding-top:clamp(40px,6vw,64px);border-top:0">
    <div class="wrap">
      <h2 class="section-title">{zh ? '往届访问学者' : 'Past visiting scholars'}</h2>
      <ul class="visiting">
        {visiting.map((v) => (
          <li>
            <span class="visiting-name">{v.name}</span>
            <span class="visiting-note">{v.note}</span>
          </li>
        ))}
      </ul>
    </div>
  </section>
</Base>
