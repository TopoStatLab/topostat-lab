---
import Base from '../layouts/Base.astro'
import PageHeading from '../components/PageHeading.astro'
import Portrait from '../components/Portrait.astro'
import { leader, director, members, type Person } from '../data/people'
import { ui, t, type Lang } from '../i18n'

interface Props {
  lang: Lang
}
const { lang } = Astro.props
const zh = lang === 'zh'

const personLd = (p: Person) => ({
  '@type': 'Person',
  name: p.name.zh,
  alternateName: p.name.en,
  ...(p.title ? { jobTitle: p.title.en } : {}),
  ...(p.homepage ? { url: p.homepage } : {}),
  affiliation: { '@type': 'ResearchOrganization', name: ui.siteName.zh },
})
const jsonLd = [{ '@context': 'https://schema.org', '@graph': [leader, director, ...members].map(personLd) }]
const other = (p: Person) => (zh ? p.name.en : p.name.zh)
---

<Base
  lang={lang}
  path="/team/"
  title={t(ui.team, lang)}
  description={zh ? '复杂系统拓扑统计理论及应用北京市重点实验室研究团队。' : 'People of the Beijing Key Laboratory of Topological Statistics and Applications for Complex Systems.'}
  jsonLd={jsonLd}
>
  <PageHeading
    lang={lang}
    title={t(ui.team, lang)}
    lead={zh ? '实验室汇聚数学、统计、物理与生命科学领域的研究者，以跨学科协作组织研究。' : 'Researchers in mathematics, statistics, physics and the life sciences, working across disciplines.'}
  />

  <section class="section" style="padding-top:clamp(40px,6vw,64px)">
    <div class="wrap">
      <ul class="people lead">
        {[leader, director].map((p) => (
          <li class="person" id={p.id}>
            <div>
              <Portrait person={p} lang={lang} eager />
              <p class="person-name">{p.name[lang]}</p>
              <p class="person-meta">{p.title ? <>{t(p.title, lang)}<br /></> : null}{other(p)}</p>
              {p.homepage && <p class="person-meta"><a class="link" href={p.homepage} target="_blank" rel="noopener">{zh ? '个人主页' : 'Profile'}</a></p>}
            </div>
          </li>
        ))}
      </ul>
      <h2 class="section-title" style="font-size:var(--t-2xl)">{zh ? '核心成员' : 'Core members'}</h2>
      <ul class="people">
        {members.map((p) => (
          <li class="person" id={p.id}>
            <div>
              <Portrait person={p} lang={lang} />
              <p class="person-name">{p.name[lang]}</p>
              <p class="person-meta">{p.title ? <>{t(p.title, lang)}<br /></> : null}{other(p)}</p>
              {p.homepage && <p class="person-meta"><a class="link" href={p.homepage} target="_blank" rel="noopener">{zh ? '个人主页' : 'Profile'}</a></p>}
            </div>
          </li>
        ))}
      </ul>
    </div>
  </section>
</Base>
