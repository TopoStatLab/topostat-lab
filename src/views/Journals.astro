---
import Base from '../layouts/Base.astro'
import PageHeading from '../components/PageHeading.astro'
import { journals } from '../data/journals'
import { linkNames } from '../data/people'
import { ui, t, type Lang } from '../i18n'

interface Props {
  lang: Lang
}
const { lang } = Astro.props
const zh = lang === 'zh'
---

<Base lang={lang} path="/journals/" title={t(ui.journals, lang)} description={zh ? '实验室成员主编的学术期刊：Data Analytics and Topology 与 Statistics Innovation。' : 'Journals edited by members of the laboratory: Data Analytics and Topology and Statistics Innovation.'}>
  <PageHeading lang={lang} title={t(ui.journals, lang)} lead={zh ? '实验室成员主编的学术期刊，欢迎投稿。' : 'Journals edited by members of the laboratory. Submissions are welcome.'} />
  <section class="wrap vsec" style="padding-top:clamp(48px,6vw,72px)">
    <p class="vlabel" aria-hidden="true">{t(ui.journals, lang)}<small>{zh ? 'Journals' : ''}</small></p>
    <ul class="software">
      {journals.map((j) => (
        <li id={j.id}>
          <div class="software-head">
            <h3><a href={j.url} target="_blank" rel="noopener">{j.name}</a></h3>
            <span class="software-kind">{j.abbr}</span>
          </div>
          <p class="software-summary">{t(j.summary, lang)}</p>
          <p class="software-meta">
            {zh ? '主编：' : 'Editor-in-Chief: '}<span set:html={linkNames(t(j.editor, lang))} />
            {zh ? '　出版：' : ' · Publisher: '}{t(j.publisher, lang)}
            {j.since && (zh ? `　创刊：${j.since} 年` : ` · Since ${j.since}`)}
          </p>
          <a class="software-open" href={j.url} target="_blank" rel="noopener">{zh ? '访问期刊' : 'Visit the journal'}<span class="software-host">{j.host}</span></a>
        </li>
      ))}
    </ul>
  </section>
</Base>
