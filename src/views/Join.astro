---
import Base from '../layouts/Base.astro'
import PageHeading from '../components/PageHeading.astro'
import { joinIntro, positions } from '../data/join'
import { site } from '../data/site'
import { ui, t, type Lang } from '../i18n'

interface Props {
  lang: Lang
}
const { lang } = Astro.props
---

<Base lang={lang} path="/join/" title={t(ui.join, lang)} noindex={!site.showJoinPage}>
  <PageHeading lang={lang} title={t(ui.join, lang)} lead={t(joinIntro, lang)} />
  <section class="section" style="padding-top:clamp(32px,5vw,56px)">
    <div class="wrap row">
      <div class="main">
        <dl class="apps">
          {positions.map((p) => (
            <div>
              <dt>{t(p.title, lang)}</dt>
              <dd>{t(p.body, lang)}</dd>
            </div>
          ))}
        </dl>
        {site.contact.email && (
          <p style="margin-top:40px">
            {lang === 'zh' ? '申请材料请发送至 ' : 'Send applications to '}
            <a class="link" href={`mailto:${site.contact.email}`}>{site.contact.email}</a>
          </p>
        )}
      </div>
    </div>
  </section>
</Base>
