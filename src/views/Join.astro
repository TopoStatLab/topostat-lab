---
import Base from '../layouts/Base.astro'
import PageHeading from '../components/PageHeading.astro'
import { joinIntro, positions } from '../data/join'
import { site } from '../data/site'
import { ui, t, type Lang } from '../i18n'

interface Props {
  lang: Lang
}
const { lang } = Astro.props
---

<Base lang={lang} path="/join/" title={t(ui.join, lang)} noindex={!site.showJoinPage}>
  <PageHeading eyebrow="JOIN US" title={t(ui.join, lang)} desc={t(joinIntro, lang)} />
  <section class="section join-page">
    <div class="page-shell join-grid">
      {positions.map((p) => (
        <article class="research-card">
          <h2>{t(p.title, lang)}</h2>
          <p class="research-body">{t(p.body, lang)}</p>
        </article>
      ))}
    </div>
    {site.contact.email && (
      <p class="page-shell join-contact">
        {lang === 'zh' ? '申请材料请发送至 ' : 'Send applications to '}
        <a href={`mailto:${site.contact.email}`}>{site.contact.email}</a>
      </p>
    )}
  </section>
</Base>
