---
interface Props {
  eyebrow: string
  title: string
  desc?: string
  light?: boolean
  as?: 'h1' | 'h2'
}
const { eyebrow, title, desc, light = false, as: Tag = 'h2' } = Astro.props
---
<div class:list={['section-heading', { light }]}>
  <p>{eyebrow}</p>
  <Tag>{title}</Tag>
  {desc && <span>{desc}</span>}
</div>
