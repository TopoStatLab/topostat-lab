---
import type { Person } from '../data/people'
import type { Lang } from '../i18n'

interface Props {
  person: Person
  lang: Lang
  large?: boolean
}
const { person, lang, large = false } = Astro.props
const remote = person.photo?.startsWith('http')
---
<div class:list={['team-portrait', { 'leader-portrait': large }]}>
  <span aria-hidden="true">{person.name.zh.slice(0, 1)}</span>
  {person.photo && (
    <img
      src={person.photo}
      alt={person.name[lang]}
      width={large ? 144 : 108}
      height={large ? 144 : 108}
      loading={large ? 'eager' : 'lazy'}
      decoding="async"
      referrerpolicy={remote ? 'no-referrer' : undefined}
      style={`object-position:${person.position ?? '50% 28%'}${person.zoom ? `;transform:scale(${person.zoom});transform-origin:${person.position}` : ''}`}
      onerror="this.remove()"
    />
  )}
</div>
