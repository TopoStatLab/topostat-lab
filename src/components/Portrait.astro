---
import type { Person } from '../data/people'
import type { Lang } from '../i18n'

interface Props {
  person: Person
  lang: Lang
  eager?: boolean
}
const { person, lang, eager = false } = Astro.props
---
<div class="portrait">
  <span aria-hidden="true">{person.name.zh.slice(0, 1)}</span>
  {person.photo && (
    <img
      src={person.photo}
      alt={person.name[lang]}
      width="288"
      height="288"
      loading={eager ? 'eager' : 'lazy'}
      decoding="async"
      onerror="this.remove()"
    />
  )}
</div>
