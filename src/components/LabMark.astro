---
// Laboratory emblem (approved logo, 2026-11). Full logo with name: /brand/logo-full.png
interface Props { class?: string }
const { class: cls = 'lab-mark' } = Astro.props
---
<picture class={cls}>
  <source type="image/webp" srcset="/brand/mark-96.webp 1x, /brand/mark-144.webp 1.5x" />
  <img src="/brand/mark-96.png" srcset="/brand/mark-96.png 1x, /brand/mark-144.png 1.5x" width="44" height="44" alt="" />
</picture>
