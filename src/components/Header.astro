---
import LabMark from './LabMark.astro'
import { site } from '../data/site'
import { tiers, members } from '../data/people'
import { journals } from '../data/journals'
import { ui, t, localizedPath, type Lang } from '../i18n'

interface Props {
  lang: Lang
  path: string
}

const { lang, path } = Astro.props
const other: Lang = lang === 'zh' ? 'en' : 'zh'
const L = (p: string) => localizedPath(p, lang)
const zh = lang === 'zh'

const navItems = [
  {
    label: t(ui.overview, lang),
    href: L('/about/'),
    match: ['/about/'],
    children: [
      [t(ui.intro, lang), L('/about/#intro')],
      [t(ui.organization, lang), L('/about/#organization')],
      [t(ui.committee, lang), L('/about/#committee')],
    ],
  },
  {
    label: t(ui.people, lang),
    href: L('/people/'),
    match: ['/people/'],
    children: tiers.filter((x) => members.some((m) => m.tier === x.id)).map((x) => [t(x.label, lang), L(`/people/#tier-${x.id}`)] as [string, string]),
  },
  {
    label: t(ui.research, lang),
    href: L('/research/'),
    match: ['/research/'],
    children: [
      [t(ui.directions, lang), L('/research/')],
    ],
  },
  {
    label: t(ui.publications, lang),
    href: L('/publications/'),
    match: ['/publications/'],
    children: [
      [t(ui.papers, lang), L('/publications/#papers')],
      [t(ui.patents, lang), L('/publications/#patents')],
    ],
  },
  { label: t(ui.journals, lang), href: L('/journals/'), match: ['/journals/'], children: journals.map((j) => [j.name, j.url] as [string, string]) },
  { label: t(ui.software, lang), href: L('/software/'), match: ['/software/'] },
  { label: t(ui.news, lang), href: L('/news/'), match: ['/news/'] },
  { label: t(ui.interviews, lang), href: L('/interviews/'), match: ['/interviews/'] },
  { label: t(ui.events, lang), href: L('/events/'), match: ['/events/'] },
  { label: t(ui.visitors, lang), href: L('/visitors/'), match: ['/visitors/'] },
  ...(site.showJoinPage ? [{ label: t(ui.join, lang), href: L('/join/'), match: ['/join/'] }] : []),
  { label: t(ui.contact, lang), href: L('/contact/'), match: ['/contact/'] },
] as { label: string; href: string; match: string[]; children?: [string, string][] }[]
---

<header class="site-header">
  <div class="wrap header-inner">
    <a class="brand" href={L('/')} aria-label={t(ui.backHome, lang)}>
      <LabMark />
      <span>
        <span class="brand-name">{zh ? '拓扑统计实验室' : 'TopoStat Lab'}</span>
        <span class="brand-sub">{zh ? '北京市重点实验室，依托 BIMSA' : 'Beijing Key Laboratory at BIMSA'}</span>
      </span>
    </a>

    <nav class="nav" id="site-nav" aria-label={t(ui.mainNav, lang)}>
      {navItems.map((item) => {
        const active = item.match.includes(path)
        return (
          <div class="nav-item">
            <a class:list={['nav-link', { active }]} href={item.href} aria-current={active ? 'page' : undefined}>
              {item.label}
              {item.children && <span class="nav-caret" aria-hidden="true" />}
            </a>
            {item.children && (
              <div class="nav-dropdown">
                {item.children.map(([label, href]) => (href.startsWith('http') ? <a href={href} target="_blank" rel="noopener">{label}</a> : <a href={href}>{label}</a>))}
              </div>
            )}
          </div>
        )
      })}
      <a class="lang" href={localizedPath(path === '/404/' ? '/' : path, other)} hreflang={other === 'zh' ? 'zh-CN' : 'en'} lang={other === 'zh' ? 'zh-CN' : 'en'}>
        {other === 'zh' ? '中文' : 'English'}
      </a>
    </nav>

    <button class="menu-btn" type="button" aria-label={t(ui.toggleNav, lang)} aria-expanded="false" aria-controls="site-nav">
      <span></span>
      <span></span>
    </button>
  </div>
</header>

<script>
  const header = document.querySelector<HTMLElement>('.site-header')!
  const btn = header.querySelector<HTMLButtonElement>('.menu-btn')!
  const nav = document.getElementById('site-nav')!
  const setOpen = (open: boolean) => {
    nav.classList.toggle('open', open)
    btn.setAttribute('aria-expanded', String(open))
  }
  btn.addEventListener('click', () => setOpen(!nav.classList.contains('open')))
  nav.addEventListener('click', (e) => {
    if ((e.target as HTMLElement).closest('a')) setOpen(false)
  })
  document.addEventListener('keydown', (e) => e.key === 'Escape' && setOpen(false))

  // The rule appears once scrolled; the header steps aside while reading down and returns on scroll up.
  let lastY = window.scrollY
  let ticking = false
  const update = () => {
    const y = window.scrollY
    header.classList.toggle('scrolled', y > 8)
    const goingDown = y > lastY + 4
    const goingUp = y < lastY - 4
    if (goingDown && y > 480 && !nav.classList.contains('open') && !header.matches(':focus-within')) header.classList.add('away')
    else if (goingUp || y < 480) header.classList.remove('away')
    lastY = y
    ticking = false
  }
  window.addEventListener('scroll', () => {
    if (!ticking) {
      ticking = true
      requestAnimationFrame(update)
    }
  }, { passive: true })
  update()
</script>
