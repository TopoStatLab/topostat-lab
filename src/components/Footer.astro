---
import { site } from '../data/site'
import LabMark from './LabMark.astro'
import { ui, t, localizedPath, type Lang } from '../i18n'

interface Props {
  lang: Lang
}
const { lang } = Astro.props
const zh = lang === 'zh'
const L = (p: string) => localizedPath(p, lang)
const year = new Date().getFullYear()
---

<footer class="footer">
  <div class="wrap footer-main">
    <div class="footer-brand">
      <LabMark class="footer-mark" />
      <div>
      <p class="footer-name">{ui.siteName.zh}</p>
      <p class="footer-en">{ui.siteName.en}</p>
      </div>
    </div>
    <div>
      <p><span style="color:#fff">{t(ui.labAddress, lang)}</span><br />{t(site.contact.locations[0].address, lang)}</p>
      <p style="margin-top:16px"><span style="color:#fff">{zh ? '依托单位' : 'Host institution'}</span><br /><a href={site.hostInstitution.url} target="_blank" rel="noopener">{zh ? '北京雁栖湖应用数学研究院（BIMSA）' : site.hostInstitution.en}</a></p>
      {site.contact.email && (
        <p style="margin-top:16px"><a href={`mailto:${site.contact.email}`}>{site.contact.email}</a></p>
      )}
    </div>
    <div>
      <h2>{zh ? '站内' : 'On this site'}</h2>
      <p>
        <a href={L('/about/')}>{t(ui.overview, lang)}</a><br />
        <a href={L('/research/')}>{t(ui.research, lang)}</a><br />
        <a href={L('/publications/')}>{t(ui.publications, lang)}</a><br />
        <a href={L('/news/')}>{t(ui.news, lang)}</a><br />
        <a href={L('/interviews/')}>{t(ui.interviews, lang)}</a><br />
        <a href={L('/events/')}>{t(ui.events, lang)}</a><br />
        <a href={L('/visitors/')}>{t(ui.visitors, lang)}</a><br />
        <a href={L('/contact/')}>{t(ui.contact, lang)}</a>
      </p>
      <h2 style="margin-top:20px">{zh ? '共建单位' : 'Co-building partner'}</h2>
      <p>{site.partnerInstitution[lang]}</p>
    </div>
  </div>
  <div class="wrap footer-bottom">
    <span>© {year} {zh ? '复杂系统拓扑统计理论及应用北京市重点实验室' : ui.siteName.en}<span class="watermark-foot" aria-hidden="true">{t(ui.motto, lang)}</span></span>
    <span>
      {site.icp && <a href="https://beian.miit.gov.cn/" target="_blank" rel="noopener">{site.icp}</a>}
      {site.policeFiling && (
        <a href={`https://beian.mps.gov.cn/#/query/webSearch?code=${site.policeFiling.code}`} target="_blank" rel="noopener">{site.policeFiling.text}</a>
      )}
      {site.visitCounter && (
        <span id="busuanzi_container_site_pv" class="site-visit-counter" style="display:none" title={t(ui.visits, lang)}>
          <svg viewBox="0 0 24 24" aria-hidden="true"><path d="M2.5 12s3.5-6 9.5-6 9.5 6 9.5 6-3.5 6-9.5 6-9.5-6-9.5-6Z"></path><circle cx="12" cy="12" r="2.7"></circle></svg>
          <span class="visually-hidden">{t(ui.visits, lang)}</span>
          <span id="busuanzi_value_site_pv">--</span>
        </span>
      )}
    </span>
  </div>
  {site.visitCounter && <script is:inline async src="https://busuanzi.ibruce.info/busuanzi/2.3/busuanzi.pure.mini.js"></script>}
</footer>
