---
/** A site photo as <picture>: AVIF first, WebP fallback, sized by `sizes`. */
import { avifSet, webpSet, type Media } from '../data/media'
interface Props {
  image: Media
  sizes: string
  alt?: string
  eager?: boolean
  class?: string
}
const { image, sizes, alt = '', eager = false, class: cls } = Astro.props
---
<picture class={cls}>
  <source type="image/avif" srcset={avifSet(image)} sizes={sizes} />
  <img src={image.sm} srcset={webpSet(image)} sizes={sizes} alt={alt} loading={eager ? 'eager' : 'lazy'} fetchpriority={eager ? 'high' : undefined} decoding="async" />
</picture>
