---
import { ui, t, localizedPath, type Lang } from '../i18n'
import Contours from './Contours.astro'

interface Props {
  lang: Lang
  title: string
  lead?: string
  /** Seed for the contour map; defaults to one derived from the title. */
  seed?: number
}
const { lang, title, lead } = Astro.props
const seed = Astro.props.seed ?? [...title].reduce((s, c) => (s * 31 + c.codePointAt(0)!) % 100003, 7)
---
<header class="page-banner">
  <Contours seed={seed} />
  <p class="watermark watermark-banner" aria-hidden="true">{t(ui.motto, lang)}</p>
  <div class="wrap">
    <p class="crumbs"><a href={localizedPath('/', lang)}>{t(ui.home, lang)}</a><span aria-hidden="true">／</span>{title}</p>
    <h1>{title}</h1>
    {lead && <p class="page-lead">{lead}</p>}
  </div>
</header>
