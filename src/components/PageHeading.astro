---
import { ui, t, localizedPath, type Lang } from '../i18n'
import type { Media } from '../data/media'
import Picture from './Picture.astro'

interface Props {
  lang: Lang
  title: string
  lead?: string
  /** Optional photo: renders a full-bleed banner instead of the plain heading. */
  image?: Media
}
const { lang, title, lead, image } = Astro.props
const zh = lang === 'zh'
---
{image ? (
  <header class="page-banner">
    <Picture image={image} sizes="100vw" eager />
    <div class="wrap">
      <p class="crumbs"><a href={localizedPath('/', lang)}>{t(ui.home, lang)}</a> / {title}</p>
      <h1>{title}</h1>
      {lead && <p class="page-lead">{lead}</p>}
    </div>
    <p class="banner-credit">{zh ? '图片：' : 'Photo: '}{image.credit[lang]}</p>
  </header>
) : (
  <header class="page-head">
    <div class="wrap row">
      <div class="main">
        <p class="crumbs"><a href={localizedPath('/', lang)}>{t(ui.home, lang)}</a> / {title}</p>
        <h1 class="page-title">{title}</h1>
        {lead && <p class="page-lead">{lead}</p>}
      </div>
      <aside class="note-slot"><slot name="note" /></aside>
    </div>
  </header>
)}
