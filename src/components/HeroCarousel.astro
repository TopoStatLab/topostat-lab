---
/** Full-bleed photo carousel for the home page: one slide per story. */
import { avifSet, webpSet, type Media } from '../data/media'
import type { Lang } from '../i18n'

export type Slide = { image: Media; kicker: string; title: string; summary?: string; href?: string; external?: boolean }
interface Props {
  slides: Slide[]
  lang: Lang
}
const { slides, lang } = Astro.props
const zh = lang === 'zh'
---
<section class="hero" aria-roledescription="carousel" aria-label={zh ? '实验室要闻' : 'Highlights'} data-hero>
  {slides.map((s, i) => (
    <article class={`hero-slide${i === 0 ? ' is-on' : ''}`} aria-roledescription="slide" aria-label={`${i + 1} / ${slides.length}`} aria-hidden={i === 0 ? undefined : 'true'}>
      {i === 0 ? (
        <picture>
          <source type="image/avif" srcset={avifSet(s.image)} sizes="100vw" />
          <img src={s.image.sm} srcset={webpSet(s.image)} sizes="100vw" alt={s.image.alt[lang]} fetchpriority="high" decoding="async" />
        </picture>
      ) : (
        <picture data-defer>
          <source type="image/avif" data-srcset={avifSet(s.image)} sizes="100vw" />
          <img data-src={s.image.sm} data-srcset={webpSet(s.image)} sizes="100vw" alt={s.image.alt[lang]} decoding="async" />
        </picture>
      )}
      <div class="hero-shade"></div>
      <div class="wrap hero-copy">
        <p class="hero-kicker">{s.kicker}</p>
        <h2 class="hero-title">{s.href ? <a href={s.href} target={s.external ? '_blank' : undefined} rel={s.external ? 'noopener' : undefined} tabindex={i === 0 ? undefined : -1}>{s.title}</a> : s.title}</h2>
        {s.summary && <p class="hero-summary">{s.summary}</p>}
        <p class="hero-credit">{zh ? '图片：' : 'Photo: '}{s.image.credit[lang]}</p>
      </div>
    </article>
  ))}
  <div class="wrap hero-controls">
    <button type="button" class="hero-arrow" data-dir="-1" aria-label={zh ? '上一张' : 'Previous'}><svg viewBox="0 0 24 24" width="20" height="20" aria-hidden="true"><path d="M15 5l-7 7 7 7" fill="none" stroke="currentColor" stroke-width="1.6" /></svg></button>
    <div class="hero-dots" role="tablist">
      {slides.map((_, i) => <button type="button" role="tab" class={`hero-dot${i === 0 ? ' is-on' : ''}`} aria-selected={i === 0 ? 'true' : 'false'} aria-label={`${i + 1}`} data-i={i}><span></span></button>)}
    </div>
    <button type="button" class="hero-arrow" data-dir="1" aria-label={zh ? '下一张' : 'Next'}><svg viewBox="0 0 24 24" width="20" height="20" aria-hidden="true"><path d="M9 5l7 7-7 7" fill="none" stroke="currentColor" stroke-width="1.6" /></svg></button>
  </div>
</section>

<script>
  const root = document.querySelector<HTMLElement>('[data-hero]')
  if (root) {
    const slides = [...root.querySelectorAll<HTMLElement>('.hero-slide')]
    const dots = [...root.querySelectorAll<HTMLButtonElement>('.hero-dot')]
    const reduced = matchMedia('(prefers-reduced-motion: reduce)').matches
    let i = 0
    let timer = 0
    // Hidden slides carry their sources in data-* so only the first photo loads with the page.
    const load = (n: number) => {
      const pic = slides[(n + slides.length) % slides.length].querySelector<HTMLElement>('picture[data-defer]')
      if (!pic) return
      pic.removeAttribute('data-defer')
      pic.querySelectorAll<HTMLElement>('[data-srcset]').forEach((el) => { el.setAttribute('srcset', el.dataset.srcset!); el.removeAttribute('data-srcset') })
      const img = pic.querySelector('img')!
      if (img.dataset.src) { img.src = img.dataset.src; img.removeAttribute('data-src') }
    }
    const show = (n: number) => {
      i = (n + slides.length) % slides.length
      load(i)
      load(i + 1)
      slides.forEach((s, k) => {
        s.classList.toggle('is-on', k === i)
        s.toggleAttribute('aria-hidden', k !== i)
        s.querySelector('a')?.setAttribute('tabindex', k === i ? '0' : '-1')
      })
      dots.forEach((d, k) => { d.classList.toggle('is-on', k === i); d.setAttribute('aria-selected', String(k === i)) })
      // Restart the progress bar on the active dot.
      root.style.setProperty('--hero-run', reduced ? 'none' : '')
    }
    const play = () => { if (!reduced) { clearInterval(timer); timer = window.setInterval(() => show(i + 1), 6500) } }
    const stop = () => clearInterval(timer)
    dots.forEach((d) => d.addEventListener('click', () => { show(Number(d.dataset.i)); play() }))
    root.querySelectorAll<HTMLButtonElement>('.hero-arrow').forEach((b) => b.addEventListener('click', () => { show(i + Number(b.dataset.dir)); play() }))
    root.addEventListener('pointerenter', stop)
    root.addEventListener('pointerleave', play)
    root.addEventListener('focusin', stop)
    // Swipe on touch screens.
    let x0 = 0
    root.addEventListener('touchstart', (e) => { x0 = e.touches[0].clientX }, { passive: true })
    root.addEventListener('touchend', (e) => { const dx = e.changedTouches[0].clientX - x0; if (Math.abs(dx) > 40) { show(i + (dx < 0 ? 1 : -1)); play() } })
    document.addEventListener('visibilitychange', () => (document.hidden ? stop() : play()))
    // Fetch the second photo once the page has settled, ahead of the first rotation.
    const warm = () => setTimeout(() => load(1), 2500)
    if (document.readyState === 'complete') warm(); else addEventListener('load', warm, { once: true })
    play()
  }
</script>
