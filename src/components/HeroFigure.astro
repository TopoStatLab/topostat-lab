---
import { ui, t, localizedPath, type Lang } from '../i18n'
import { site } from '../data/site'

interface Props {
  lang: Lang
}
const { lang } = Astro.props
const zh = lang === 'zh'
const L = (p: string) => localizedPath(p, lang)
---

<section class="fig1" data-lang={lang} aria-labelledby="fig1-title">
  <div class="fig1-stage">
    <div class="wrap fig1-grid">
      <div>
        <h1 class="fig1-title" id="fig1-title">
          {zh ? (
            <><span>复杂系统</span><span>拓扑统计理论及应用</span></>
          ) : (
            <><span>Topological statistics</span><span>for complex systems</span></>
          )}
        </h1>
        <p class="fig1-org">{zh ? '北京市重点实验室' : 'Beijing Key Laboratory'}</p>
        <p class="fig1-lead">
          {zh
            ? '我们把拓扑学引入统计推断，研究网络、流形与高阶互作中的“形状”，并把它用于生物医学、人工智能与真实世界的复杂系统。'
            : 'We bring topology into statistical inference — studying the shape of networks, manifolds and higher-order interactions, and applying it to biomedicine, AI and real-world complex systems.'}
        </p>
        <div class="fig1-actions">
          <a class="btn" href={L('/research/')}>{zh ? '了解研究方向' : 'Our research'}</a>
          <a class="btn ghost" href={L('/research/#demo')}>{zh ? '自己画一组数据试试' : 'Try it on your own data'}</a>
        </div>
        <p class="fig1-host">
          {zh
            ? `依托${site.hostInstitution.zh}（BIMSA），与${site.partnerInstitution.zh}联合共建`
            : `Hosted by BIMSA, co-built with the ${site.partnerInstitution.en}`}
        </p>
      </div>

      <figure class="fig1-figure">
        <canvas class="fig1-canvas" role="img" aria-label={zh ? '图 1：两个带噪声的圆环组成的点云，以及随尺度 ε 增长的 Vietoris–Rips 复形' : 'Figure 1: a point cloud of two noisy circles and its Vietoris–Rips complex as the scale ε grows'}></canvas>
        <canvas class="fig1-barcode" aria-hidden="true"></canvas>
        <figcaption class="fig1-caption">
          <b>{zh ? '图 1' : 'Fig. 1'}</b>
          <span>
            <span class="fig1-readout" aria-live="polite"></span><br />
            <span class="fig1-text"></span>
          </span>
        </figcaption>
        <p class="fig1-hint">{zh ? '向下滚动，尺度 ε 随之增大' : 'Scroll down to grow the scale ε'}</p>
      </figure>
    </div>
  </div>
</section>

<script>
  import { ripsPersistence, bettiAt, dataset } from '../lib/persistence'

  const root = document.querySelector<HTMLElement>('.fig1')
  if (root) {
    const zh = root.dataset.lang === 'zh'
    const cloud = root.querySelector<HTMLCanvasElement>('.fig1-canvas')!
    const strip = root.querySelector<HTMLCanvasElement>('.fig1-barcode')!
    const readout = root.querySelector<HTMLElement>('.fig1-readout')!
    const text = root.querySelector<HTMLElement>('.fig1-text')!

    const EPS_MAX = 0.36
    const EPS_MIN = 0.012
    // Two noisy circles (uniform scale keeps them round).
    const points = dataset('two-circles').map((p) => ({ x: 0.5 + (p.x - 0.5) * 0.96, y: 0.5 + (p.y - 0.5) * 0.96 }))
    const { edges, triangles, bars } = ripsPersistence(points, EPS_MAX)
    const loops = bars.filter((b) => b.dim === 1 && b.death - b.birth > 0.05).sort((a, b) => a.birth - b.birth)
    const firstBirth = Math.min(...loops.map((b) => b.birth))
    const deaths = loops.map((b) => b.death).sort((a, b) => a - b)

    const css = getComputedStyle(document.documentElement)
    const C = {
      ink: css.getPropertyValue('--ink').trim() || '#0f1e2e',
      prussian: css.getPropertyValue('--prussian').trim() || '#17407a',
      ochre: css.getPropertyValue('--ochre').trim() || '#c98a1e',
      rule: css.getPropertyValue('--rule').trim() || '#d3dbe2',
    }

    const fit = (canvas: HTMLCanvasElement) => {
      const dpr = Math.min(window.devicePixelRatio || 1, 2)
      const { width, height } = canvas.getBoundingClientRect()
      if (canvas.width !== Math.round(width * dpr)) {
        canvas.width = Math.round(width * dpr)
        canvas.height = Math.round(height * dpr)
      }
      const ctx = canvas.getContext('2d')!
      ctx.setTransform(dpr, 0, 0, dpr, 0, 0)
      return { ctx, w: width, h: height }
    }

    const caption = (eps: number, b0: number, b1: number) => {
      if (eps < 0.035)
        return zh
          ? '每个点是一次观测。以每个点为圆心画半径 ε/2 的圆，ε 从 0 开始增大。'
          : 'Each point is an observation. Draw a ball of radius ε/2 around every point and let ε grow from zero.'
      if (eps < firstBirth)
        return zh
          ? `相交的圆连成边，三点两两相连就填成三角形。零散的点正在合并：还剩 ${b0} 个连通分支。`
          : `Balls that meet are joined by an edge; three mutually joined points become a triangle. Scattered points are merging into ${b0} components.`
      if (b1 >= 2)
        return zh ? '两个环出现了。数据的形状开始显露：它不是一团点，而是两个圈。' : 'Two loops appear. The data has a shape: not a blob, but two rings.'
      if (b1 === 1 && eps >= deaths[0])
        return zh
          ? '小环被三角形填满后消失，大环还在。它持续得更久，更可能是数据真实的结构。'
          : 'The small loop fills in and vanishes; the large one survives. Features that persist longer are more likely to be real structure.'
      if (b1 === 1)
        return zh ? '第一个环出现了。' : 'A first loop appears.'
      return zh
        ? '两个环都被填满。持续越久的特征越可能是真实结构，转瞬即逝的多半是噪声。这就是持续同调。'
        : 'Both loops have filled in. Long-lived features are signal; fleeting ones are noise. That is persistent homology.'
    }

    let eps = EPS_MIN
    let lastKey = ''

    const draw = () => {
      // point cloud: each layer is filled once as a union, so tones stay even
      const { ctx, w: cw, h: ch } = fit(cloud)
      ctx.clearRect(0, 0, cw, ch)
      const X = (x: number) => x * cw
      const Y = (y: number) => ch / 2 + (y - 0.5) * cw
      const r = (eps / 2) * cw
      ctx.beginPath()
      for (const p of points) {
        ctx.moveTo(X(p.x) + r, Y(p.y))
        ctx.arc(X(p.x), Y(p.y), r, 0, Math.PI * 2)
      }
      ctx.fillStyle = 'rgba(77, 184, 214, 0.16)'
      ctx.fill('nonzero')
      ctx.beginPath()
      for (const tri of triangles) {
        if (tri.value > eps) break
        const a = points[tri.a], b = points[tri.b], c = points[tri.c]
        // consistent winding so the nonzero rule unions overlapping triangles
        const cross = (b.x - a.x) * (c.y - a.y) - (b.y - a.y) * (c.x - a.x)
        const [q, s2] = cross > 0 ? [b, c] : [c, b]
        ctx.moveTo(X(a.x), Y(a.y))
        ctx.lineTo(X(q.x), Y(q.y))
        ctx.lineTo(X(s2.x), Y(s2.y))
        ctx.closePath()
      }
      ctx.fillStyle = 'rgba(23, 64, 122, 0.16)'
      ctx.fill('nonzero')
      ctx.strokeStyle = 'rgba(23, 64, 122, 0.5)'
      ctx.lineWidth = 0.8
      ctx.beginPath()
      for (const e of edges) {
        if (e.len > eps) break
        ctx.moveTo(X(points[e.a].x), Y(points[e.a].y))
        ctx.lineTo(X(points[e.b].x), Y(points[e.b].y))
      }
      ctx.stroke()
      ctx.fillStyle = C.ink
      for (const p of points) {
        ctx.beginPath()
        ctx.arc(X(p.x), Y(p.y), 2.6, 0, Math.PI * 2)
        ctx.fill()
      }

      // barcode strip: H0 hairlines above, H1 bars below
      const { ctx: g, w, h } = fit(strip)
      g.clearRect(0, 0, w, h)
      const x = (v: number) => (Math.min(v, EPS_MAX) / EPS_MAX) * w
      const h0 = bars.filter((b) => b.dim === 0).sort((a, b) => b.death - a.death)
      const top = h * 0.5
      const row0 = top / h0.length
      h0.forEach((b, i) => {
        const alive = eps < b.death
        g.fillStyle = alive ? 'rgba(23, 64, 122, 0.7)' : 'rgba(23, 64, 122, 0.18)'
        g.fillRect(0, i * row0, Math.max((b.death === Infinity ? w : x(b.death)) , 1), Math.max(row0 * 0.6, 0.6))
      })
      const rowH = (h - top - 6) / Math.max(loops.length, 1)
      loops.forEach((b, i) => {
        const alive = b.birth <= eps && eps < b.death
        g.fillStyle = alive ? C.ochre : 'rgba(201, 138, 30, 0.3)'
        const y = top + 6 + i * rowH
        g.fillRect(x(b.birth), y + rowH * 0.2, x(b.death) - x(b.birth), rowH * 0.55)
      })
      g.fillStyle = C.ink
      g.fillRect(Math.min(x(eps), w - 1), 0, 1, h)

      // caption + readout
      const [b0, b1] = bettiAt(bars, eps)
      const key = `${b0}/${b1}/${eps < 0.035}/${eps < firstBirth}/${eps >= deaths[0]}`
      readout.innerHTML = `<span class="m">ε</span> = ${eps.toFixed(3)}　<span class="m">β<sub>0</sub></span> = ${b0}　<span class="m h1">β<sub>1</sub></span> = <span class="h1">${b1}</span>`
      if (key !== lastKey) {
        text.textContent = caption(eps, b0, b1)
        lastKey = key
      }
    }

    let raf = 0
    const onScroll = () => {
      cancelAnimationFrame(raf)
      raf = requestAnimationFrame(() => {
        const rect = root.getBoundingClientRect()
        const range = root.offsetHeight - window.innerHeight
        const p = Math.min(1, Math.max(0, -rect.top / Math.max(range, 1)))
        eps = EPS_MIN + p * (EPS_MAX - EPS_MIN)
        root.classList.toggle('scrolled', p > 0.02)
        draw()
      })
    }
    window.addEventListener('scroll', onScroll, { passive: true })
    window.addEventListener('resize', onScroll)
    onScroll()
  }
</script>
