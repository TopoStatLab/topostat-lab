---
/**
 * Generated contour map (the site's signature image): ridges of the Yanshan
 * hills above a lake, traced with marching squares. Each page passes its own
 * seed, so every banner shows different terrain. Drawn in the browser so the
 * HTML stays small; with no script the area is plain paper.
 */
interface Props {
  seed: number
  /** 'hero' for the home page (taller, with the lake), 'banner' for subpages. */
  variant?: 'hero' | 'banner'
}
const { seed, variant = 'banner' } = Astro.props
---
<svg class={`contours contours-${variant}`} data-seed={seed} data-variant={variant} aria-hidden="true" preserveAspectRatio="xMidYMid slice"></svg>

<script>
  type Bump = [number, number, number, number]
  function terrain(seed: number, hero: boolean) {
    let s = seed * 9973 + 11
    const r = () => (s = (s * 16807) % 2147483647) / 2147483647
    const bumps: Bump[] = []
    const n = hero ? 34 : 22
    for (let i = 0; i < n; i++) bumps.push([0.42 + r() * 0.62, -0.15 + r() * 0.7, 0.04 + r() * 0.1, 0.35 + r() * 0.8])
    const lx = hero ? 0.76 : 0.6 + r() * 0.3, ly = hero ? 0.8 : 0.9 + r() * 0.2
    const ph = r() * 6
    return (x: number, y: number) => {
      let v = -1.6 * Math.exp(-(((x - lx) / 0.16) ** 2 + ((y - ly) / 0.16) ** 2))
      v += -0.8 * Math.exp(-(((x - lx - 0.17) / 0.12) ** 2 + ((y - ly + 0.12) / 0.12) ** 2))
      for (const [bx, by, br, bh] of bumps) v += bh * Math.exp(-((x - bx) ** 2 + (y - by) ** 2) / (br * br))
      return v + 0.12 * Math.sin(x * 9 + y * 4 + ph) * Math.cos(y * 7 - x * 3)
    }
  }
  // Marching squares: segment table indexed by the 4-corner case.
  const CASES: Record<number, number[]> = { 1: [3, 0], 2: [0, 1], 3: [3, 1], 4: [1, 2], 5: [3, 0, 1, 2], 6: [0, 2], 7: [3, 2], 8: [2, 3], 9: [2, 0], 10: [0, 1, 2, 3], 11: [2, 1], 12: [1, 3], 13: [1, 0], 14: [0, 3] }
  function draw(svg: SVGSVGElement) {
    const hero = svg.dataset.variant === 'hero'
    const W = 1600, H = hero ? 620 : 420, nx = hero ? 200 : 160, ny = hero ? 78 : 52
    const h = terrain(Number(svg.dataset.seed || 1), hero)
    const g: number[][] = []
    for (let j = 0; j <= ny; j++) { const row: number[] = []; for (let i = 0; i <= nx; i++) row.push(h(i / nx, j / ny)); g.push(row) }
    const sx = W / nx, sy = H / ny
    let ink = '', faint = '', red = ''
    for (let L = -1.3; L < 1.6; L += 0.12) {
      const shore = Math.abs(L + 0.46) < 0.06
      let d = ''
      for (let j = 0; j < ny; j++) for (let i = 0; i < nx; i++) {
        const a = g[j][i], b = g[j][i + 1], c = g[j + 1][i + 1], e = g[j + 1][i]
        const k = +(a > L) | (+(b > L) << 1) | (+(c > L) << 2) | (+(e > L) << 3)
        const segs = CASES[k]
        if (!segs) continue
        const t = (p: number, q: number) => (L - p) / (q - p)
        const P = [
          [(i + t(a, b)) * sx, j * sy], [(i + 1) * sx, (j + t(b, c)) * sy],
          [(i + t(e, c)) * sx, (j + 1) * sy], [i * sx, (j + t(a, e)) * sy],
        ]
        for (let m = 0; m < segs.length; m += 2) {
          const p = P[segs[m]], q = P[segs[m + 1]]
          d += `M${p[0].toFixed(1)} ${p[1].toFixed(1)}L${q[0].toFixed(1)} ${q[1].toFixed(1)}`
        }
      }
      if (shore) red += d
      else if (L < -0.4) faint += d
      else ink += d
    }
    const id = `cm${Math.random().toString(36).slice(2, 7)}`
    svg.setAttribute('viewBox', `0 0 ${W} ${H}`)
    svg.innerHTML =
      `<defs><linearGradient id="${id}g" x1="0" x2="1"><stop offset="${hero ? 0.38 : 0.3}" stop-color="#000"/><stop offset="${hero ? 0.68 : 0.62}" stop-color="#fff"/></linearGradient>` +
      `<mask id="${id}"><rect width="${W}" height="${H}" fill="url(#${id}g)"/></mask></defs>` +
      `<g fill="none" stroke-linecap="round" mask="url(#${id})">` +
      `<path d="${faint}" stroke="var(--ink)" stroke-opacity=".2" stroke-width=".6"/>` +
      `<path d="${ink}" stroke="var(--ink)" stroke-opacity=".32" stroke-width=".8"/>` +
      `<path d="${red}" stroke="var(--red)" stroke-opacity=".85" stroke-width="1.4"/></g>`
  }
  document.querySelectorAll<SVGSVGElement>('svg.contours').forEach(draw)
</script>
