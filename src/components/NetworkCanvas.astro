---
// Decorative animated network for the hero. Pauses when off-screen or when
// the tab is hidden, and renders a single still frame for reduced-motion users.
---
<canvas class="network-canvas" aria-hidden="true"></canvas>

<script>
  const canvas = document.querySelector<HTMLCanvasElement>('.network-canvas')
  const ctx = canvas?.getContext('2d')
  if (canvas && ctx) {
    const reduced = window.matchMedia('(prefers-reduced-motion: reduce)')
    type P = { x: number; y: number; vx: number; vy: number; r: number; phase: number; depth: number }
    let points: P[] = []
    let width = 0
    let height = 0
    let frame = 0
    let raf = 0
    let visible = true
    const LINK = 158

    const reset = () => {
      const dpr = Math.min(window.devicePixelRatio || 1, 2)
      const rect = canvas.getBoundingClientRect()
      width = rect.width
      height = rect.height
      canvas.width = width * dpr
      canvas.height = height * dpr
      ctx.setTransform(dpr, 0, 0, dpr, 0, 0)
      const count = Math.min(90, Math.max(42, Math.floor(width / 24)))
      points = Array.from({ length: count }, (_, i) => ({
        x: Math.random() * width,
        y: Math.random() * height,
        vx: (Math.random() - 0.5) * 0.16,
        vy: (Math.random() - 0.5) * 0.16,
        r: i % 9 === 0 ? 2.55 : 1.2 + Math.random() * 0.45,
        phase: Math.random() * Math.PI * 2,
        depth: 0.72 + Math.random() * 0.28,
      }))
    }

    const draw = (move: boolean) => {
      frame += 1
      ctx.clearRect(0, 0, width, height)
      if (move) {
        for (const p of points) {
          p.x += p.vx * p.depth
          p.y += p.vy * p.depth
          if (p.x < 0 || p.x > width) p.vx *= -1
          if (p.y < 0 || p.y > height) p.vy *= -1
        }
      }
      ctx.lineWidth = 0.72
      for (let i = 0; i < points.length; i += 1) {
        const a = points[i]
        for (let j = i + 1; j < points.length; j += 1) {
          const b = points[j]
          const dx = a.x - b.x
          if (dx > LINK || dx < -LINK) continue
          const dist = Math.hypot(dx, a.y - b.y)
          if (dist < LINK) {
            ctx.strokeStyle = `rgba(102, 224, 255, ${0.2 * (1 - dist / LINK) * Math.min(a.depth, b.depth)})`
            ctx.beginPath()
            ctx.moveTo(a.x, a.y)
            ctx.lineTo(b.x, b.y)
            ctx.stroke()
          }
        }
      }
      points.forEach((p, i) => {
        const core = i % 9 === 0
        const pulse = core ? 0.72 + Math.sin(frame * 0.018 + p.phase) * 0.24 : 0.58 + Math.sin(frame * 0.01 + p.phase) * 0.1
        ctx.shadowBlur = core ? 18 : 7
        ctx.shadowColor = core ? 'rgba(91, 224, 255, .88)' : 'rgba(144, 220, 245, .4)'
        ctx.fillStyle = `rgba(${core ? '109, 231, 255' : '194, 234, 248'}, ${pulse})`
        ctx.beginPath()
        ctx.arc(p.x, p.y, p.r, 0, Math.PI * 2)
        ctx.fill()
      })
      ctx.shadowBlur = 0
    }

    const loop = () => {
      draw(true)
      raf = requestAnimationFrame(loop)
    }
    const start = () => {
      cancelAnimationFrame(raf)
      if (reduced.matches) draw(false)
      else if (visible && !document.hidden) loop()
    }
    const stop = () => cancelAnimationFrame(raf)

    reset()
    start()
    new IntersectionObserver(([entry]) => {
      visible = entry.isIntersecting
      visible ? start() : stop()
    }).observe(canvas)
    document.addEventListener('visibilitychange', () => (document.hidden ? stop() : start()))
    reduced.addEventListener('change', start)
    let resizeTimer = 0
    window.addEventListener('resize', () => {
      clearTimeout(resizeTimer)
      resizeTimer = window.setTimeout(() => {
        reset()
        start()
      }, 150)
    })
  }
</script>
