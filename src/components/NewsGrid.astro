---
import { news, newsCategories, formatDate } from '../data/news'
import { ui, t, type Lang } from '../i18n'

interface Props {
  lang: Lang
  /** Max items per category (home page preview). */
  limit?: number
}
const { lang, limit } = Astro.props
---
<div class="news-category-grid">
  {newsCategories.map((cat) => {
    const items = news.filter((n) => n.category === cat.id).slice(0, limit ?? Infinity)
    return (
      <section class="news-category anchor-target" id={limit ? undefined : cat.anchor}>
        <div class="news-category-head">
          <p>{cat.eyebrow}</p>
          <h3>{t(cat.title, lang)}</h3>
          <span>{t(cat.desc, lang)}</span>
        </div>
        <div class="news-mini-list">
          {items.map((item) => {
            const Tag = item.href ? 'a' : 'div'
            return (
              <Tag class="news-mini-card" href={item.href} target={item.href ? '_blank' : undefined} rel={item.href ? 'noopener' : undefined}>
                <div class="news-mini-meta">
                  <span>{t(cat.title, lang)}</span>
                  <time datetime={item.date}>{formatDate(item.date, lang)}</time>
                </div>
                <h4>{t(item.title, lang)}</h4>
                {item.summary && !limit && <p class="news-mini-summary">{t(item.summary, lang)}</p>}
                {item.href && <b>{t(ui.readMore, lang)} ↗</b>}
              </Tag>
            )
          })}
        </div>
      </section>
    )
  })}
</div>
