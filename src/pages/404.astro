---
import Base from '../layouts/Base.astro'
---
<Base lang="zh" path="/404/" title="页面不存在" noindex>
  <header class="page-head" style="min-height:60vh">
    <div class="wrap">
      <h1 class="page-title">这个页面不存在</h1>
      <p class="page-lead">链接可能已经失效，或者地址有拼写错误。<br /><span lang="en">This page doesn’t exist.</span></p>
      <p style="margin-top:32px;display:flex;gap:12px;flex-wrap:wrap">
        <a class="btn" href="/">返回首页</a>
        <a class="btn ghost" href="/en/" lang="en">English home</a>
      </p>
    </div>
  </header>
</Base>
