---
// The team page moved to /people/.
const target = '/en/people/'
---
<!doctype html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="robots" content="noindex" />
    <link rel="canonical" href={`https://topostat.cn${target}`} />
    <meta http-equiv="refresh" content={`0; url=${target}`} />
    <title>Redirecting</title>
  </head>
  <body><a href={target}>{target}</a></body>
</html>
